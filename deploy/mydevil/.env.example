# ulams on MyDevil: platform .env, saved as ~/ulams/api/.env (chmod 600). Never commit the filled-in file.
# Every value marked CHANGE is required. Tenants get their own .env.<host> from `ulams:tenant:create`.
# Read deploy/mydevil/README.md first. Values marked "(to confirm)" depend on facts only the account shows.

APP_NAME=ulams
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=warning
# Encrypts the tenant secrets: generate once, keep it in a password manager, never regenerate (ADR 0066).
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=CHANGE
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
ADMIN_URL=https://admin.example.com

# --- PostgreSQL (devil pgsql db add <name>). Host: pgsql<N>.mydevil.net where the SSH server is s<N>.mydevil.net
DB_CONNECTION=pgsql
DB_HOST=pgsqlN.mydevil.net
DB_PORT=5432
# MyDevil may prefix names with the account (e.g. m1234_ulams): use the name `devil pgsql list` shows
DB_DATABASE=CHANGE
DB_USERNAME=CHANGE
DB_PASSWORD=CHANGE

# --- Tenants: MyDevil gives the app no CREATEDB right, so each tenant database is created by hand
# (bin/add-tenant.sh) and `ulams:tenant:create --db-password=` only checks the login (ADR 0091)
TENANCY_DATABASE_PROVISIONER=manual
# Names follow the account prefix of devil pgsql: m1234_{slug}
TENANCY_DATABASE=CHANGE_{slug}
TENANCY_SCHEME=https
TENANCY_PLATFORM_HOSTS=api.example.com
TENANCY_API_HOST={slug}.api.example.com
TENANCY_FRONT_HOST={slug}.app.example.com
TENANCY_ADMIN_HOST={slug}.admin.example.com
TENANCY_CONTENT_HOST={slug}.content.example.com
TENANCY_EMAIL_DOMAIN={slug}.example.com
# `ulams:tenant:create` starts `php artisan` itself; under php-fpm PHP_BINARY is not the CLI
TENANCY_PHP_BINARY=/usr/local/bin/php84
TENANT_DEMO_PASSWORD=CHANGE
# Platform admin, created by the seeder while the users table is empty
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=CHANGE

# --- Queue and cache without Redis (default for this variant). Workers are cron lines (crontab).
# Switch to redis only after bin/redis-start.sh runs (see the README, "Redis").
QUEUE_CONNECTION=database
QUEUE_DRIVER=database
# no `cache` table migration exists, so the cache is on disk (storage/framework/cache), not the database
CACHE_DRIVER=file
SESSION_DRIVER=cookie
BROADCAST_DRIVER=log
# Used by the H5P service and by the optional Redis (unix socket or reserved TCP port, bind 127.0.0.1)
#REDIS_CLIENT=phpredis
#REDIS_HOST=/usr/home/LOGIN/redis/redis.sock
#REDIS_PORT=0
#REDIS_PASSWORD=CHANGE

# --- Object storage: Cloudflare R2 (S3 API). Endpoint: https://<account id>.r2.cloudflarestorage.com
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=CHANGE
AWS_SECRET_ACCESS_KEY=CHANGE
AWS_DEFAULT_REGION=auto
AWS_BUCKET=ulams
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Public base URL of the buckets (an R2 custom domain); the bucket name is appended
AWS_URL=https://storage.example.com/ulams
AWS_USE_PATH_STYLE_ENDPOINT=true
TENANCY_STORAGE_PUBLIC_URL=https://storage.example.com
# R2 has no bucket policies: the buckets are made public by hand (README, section 6)
TENANCY_S3_PUBLIC_READ_POLICY=false

# --- E-mail: the MyDevil SMTP server (devil mail) or any relay. Avoid PHP mail().
MAIL_DRIVER=smtp
MAIL_HOST=CHANGE
MAIL_PORT=587
MAIL_USERNAME=CHANGE
MAIL_PASSWORD=CHANGE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ulams

# --- Node services (optional, see the README): internal URLs and shared tokens (openssl rand -hex 32)
H5P_SERVICE_URL=https://h5p.example.com
H5P_INTERNAL_TOKEN=CHANGE
PDF_SERVICE_URL=https://pdf.example.com
PDF_INTERNAL_TOKEN=CHANGE
#MJML_API_URL=https://mjml.example.com/v1

# --- AI. The model names live in config; the key is the platform's (tenants inherit it)
ANTHROPIC_API_KEY=

# --- Run-time hints for the cron scripts (bin/cron-tick.sh); defaults in the script
#ULAMS_PHP=/usr/local/bin/php84
#ULAMS_QUEUE_DRIVER=database
SENTRY_LARAVEL_DSN=
