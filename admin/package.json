{
  "name": "admin",
  "version": "6.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "license": "MIT",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 node scripts/max.cjs build",
    "build": "node scripts/max.cjs build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "env-cmd -f .env npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "node scripts/max.cjs setup",
    "jest": "jest",
    "lint": "npm run lint:js && npm run lint:prettier && npm run tsc",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src ",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "playwright": "PORT=8000 playwright install && playwright test",
    "playwright:debug": "PORT=8000 playwright install && playwright test --debug",
    "playwright:headed": "PORT=8000 playwright install && playwright test --headed --project=chromium",
    "playwright:local": "PORT=8000 playwright test",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && node scripts/max.cjs preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test node scripts/max.cjs record --scene=login",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ulams --project ulams-admin ./dist && sentry-cli --url https://ulams.sentry.io sourcemaps upload --org ulams --project ulams-admin ./dist",
    "serve": "REACT_APP_API_URL=http://localhost PORT=8000 umi-serve",
    "start": "cross-env UMI_ENV=dev node scripts/max.cjs dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev node scripts/max.cjs dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev node scripts/max.cjs dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev node scripts/max.cjs dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev node scripts/max.cjs dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:e2e": "PORT=8000 node ./tests/run-tests.js",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc -b src/lib/markdown-editor && NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "tsc:noemit": "tsc -b src/lib/markdown-editor && NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "typecheck": "tsc -b src/lib/markdown-editor && NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/components/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/.umi/**/*"
    ],
    "coverageDirectory": "./coverage/",
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest/setupTests.js"
    ],
    "testPathIgnorePatterns": [
      "/e2e/"
    ],
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!antd|@ant-design|rc-.+?|@babel/runtime).+(js|jsx)$"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^4.8.1",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "2.8.4",
    "@atlaskit/tree": "^8.8.7",
    "@benrbray/prosemirror-math": "0.2.2",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@pdfme/common": "6.2.4",
    "@pdfme/schemas": "6.2.4",
    "@pdfme/ui": "6.2.4",
    "@sentry/cli": "^2.40.0",
    "@sentry/esbuild-plugin": "^2.22.7",
    "@sentry/react": "^8",
    "@testing-library/jest-dom": "^6.4.5",
    "@umijs/route-utils": "^2.2.2",
    "@webscopeio/react-textarea-autocomplete": "^4.9.2",
    "antd": "^5.15.3",
    "antd-style": "^3.6.1",
    "array-move": "^4.0.0",
    "babel-jest": "^29.7.0",
    "babel-preset-react-app": "^10.1.0",
    "classnames": "^2.5.1",
    "conditional-wrap": "^1.0.3",
    "copy-to-clipboard": "^3.0.8",
    "cross-port-killer": "^1.4.0",
    "date-fns": "^3.3.1",
    "enzyme": "^3.11.0",
    "export-to-csv": "^1.5.0",
    "file-saver": "^2.0.5",
    "jest-esm-transformer": "^1.0.0",
    "jsoneditor": "^10.4.3",
    "jsoneditor-react": "^3.1.2",
    "jszip": "^3.10.2",
    "jwt-decode": "^4.0.0",
    "katex": "^0.19.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.0.0",
    "markdown-it-container": "^3.0.0",
    "markdown-it-mathjax": "^2.0.0",
    "moment": "^2.31.0",
    "omit.js": "^2.0.2",
    "outline-icons": "^1.27.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.13.3",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-utils": "^0.9.6",
    "prosemirror-view": "^1.17.6",
    "querystring": "^0.2.1",
    "rc-menu": "^9.16.1",
    "rc-util": "^5.38.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.4.4",
    "react-helmet-async": "^3.0.0",
    "react-indiana-drag-scroll": "^2.2.1",
    "react-json-view": "^1.21.3",
    "react-medium-image-zoom": "^3.1.3",
    "react-pdf": "^8.0.0",
    "react-player": "^2.14.1",
    "react-portal": "^4.3.0",
    "react-sortable-hoc": "^2.0.0",
    "react-tiny-oembed": "^1.1.0",
    "recharts": "^3.10.1",
    "refractor": "^3.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "scorm-again": "^2.6.0",
    "slugify": "^1.6.9",
    "smooth-scroll-into-view-if-needed": "^2.0.2"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.4.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^13.4.0",
    "@types/classnames": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/history": "^4.7.11",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.17.25",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-helmet": "^6.1.11",
    "@types/uuid": "^9.0.8",
    "@types/webscopeio__react-textarea-autocomplete": "^4.7.5",
    "@umijs/fabric": "^4.0.1",
    "@umijs/lint": "^4.7.22",
    "@umijs/max": "^4.7.22",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "gh-pages": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "madge": "6.0.0",
    "mockjs": "^1.1.0",
    "prettier": "^3.9.9",
    "react-dev-inspector": "^1.9.0",
    "swagger-ui-dist": "^4.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "umi-presets-pro": "^2.0.3",
    "umi-serve": "^1.9.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "create-umi": {
    "ignoreScript": [
      "docker*",
      "functions*",
      "site",
      "generateMock"
    ],
    "ignoreDependencies": [
      "netlify*",
      "serverless"
    ],
    "ignore": [
      ".dockerignore",
      ".git",
      ".github",
      ".gitpod.yml",
      "CODE_OF_CONDUCT.md",
      "Dockerfile",
      "Dockerfile.*",
      "lambda",
      "LICENSE",
      "netlify.toml",
      "README.*.md",
      "azure-pipelines.yml",
      "docker",
      "CNAME",
      "create-umi"
    ]
  }
}
