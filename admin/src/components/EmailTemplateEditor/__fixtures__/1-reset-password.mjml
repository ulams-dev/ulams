<mjml>
  <mj-body>
    <mj-section background-color="white">
      <mj-column>
        <mj-text
          ><p>
            You are receiving this email because we received a password reset request for your
            account.
          </p></mj-text
        ><mj-button href="@VarActionLink">Reset Password</mj-button
        ><mj-text
          ><p>This password reset link will expire in @VarActionLinkExpiration minutes.</p>
          <p>If you did not request a password reset, no further action is required.</p></mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
