{
  "realm": "ulams",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "groups": [
    { "name": "nurses" },
    { "name": "admins" }
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "enabled": true,
      "groups": ["/nurses"],
      "credentials": [{ "type": "password", "value": "ada-password-1", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": false,
      "firstName": "Bob",
      "lastName": "Builder",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob-password-1", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "ulams-web",
      "name": "ulams (conformance)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "keycloak-conformance-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://ulams.test:18000/api/identity/oidc/keycloak/callback"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["web-origins", "profile", "email", "roles"],
      "optionalClientScopes": []
    }
  ]
}
