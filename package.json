{
  "name": "wellms",
  "private": true,
  "description": "Wellms LMS monorepo: api (Laravel), admin (umi/max) and front (Vite).",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": {
    "packages": [
      "admin",
      "front",
      "api"
    ],
    "nohoist": [
      "front/**/@types/react-router",
      "front/@types/react-router-dom"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --filter=admin --filter=front",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:front": "turbo run dev --filter=front",
    "dev:api": "docker compose -f api/docker-compose.yml up -d",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=admin --filter=front",
    "test:api": "yarn workspace api test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.11.7"
  },
  "resolutions": {
    "**/dva-immer/immer": "^9.0.6",
    "**/fmin/rollup": "^2.79.2",
    "underscore": "^1.12.1",
    "body-parser": "^1.20.3",
    "node-fetch": "^2.6.7"
  }
}
