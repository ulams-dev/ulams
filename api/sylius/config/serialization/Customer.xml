<?xml version="1.0" ?>

<serializer xmlns="http://symfony.com/schema/dic/serializer-mapping"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://symfony.com/schema/dic/serializer-mapping https://symfony.com/schema/dic/serializer-mapping/serializer-mapping-1.0.xsd"
>
    <class name="App\Entity\Customer\Customer">
        <!-- the link to the LMS user: written and read through the admin API only (the LMS), never exposed to the shop -->
        <attribute name="ulamsUserRef">
            <group>sylius:admin:customer:create</group>
            <group>sylius:admin:customer:update</group>
            <group>sylius:admin:customer:show</group>
            <group>sylius:admin:customer:index</group>
        </attribute>
    </class>
</serializer>
