{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feedback on a learner's own explanation",
  "type": "object",
  "additionalProperties": false,
  "required": ["correct", "missing", "followUp", "citations"],
  "properties": {
    "correct": {"type": "string", "minLength": 1, "maxLength": 600},
    "missing": {"type": "string", "maxLength": 600},
    "followUp": {"type": "string", "minLength": 1, "maxLength": 300},
    "citations": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "pattern": "^frg_[a-z2-7]{12}$"}}
  }
}
