{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal remediation",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "blocks"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 300},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "markdown", "citations"],
        "properties": {
          "kind": {"type": "string", "enum": ["explanation", "worked_example", "practice", "elaboration"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "markdown": {"type": "string", "minLength": 1, "maxLength": 1800},
          "citations": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "pattern": "^frg_[a-z2-7]{12}$"}},
          "practice": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stem", "options", "explanation"],
            "properties": {
              "stem": {"type": "string", "minLength": 1, "maxLength": 400},
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "correct"],
                  "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 200}, "correct": {"type": "boolean"}}
                }
              },
              "explanation": {"type": "string", "minLength": 1, "maxLength": 400}
            }
          }
        }
      }
    }
  }
}
