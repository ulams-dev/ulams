{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course outline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "course",
    "modules"
  ],
  "properties": {
    "message": {
      "type": "string",
      "description": "Note to the author, plain text",
      "maxLength": 800,
      "minLength": 1
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "description",
        "objectives"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Course title",
          "maxLength": 200,
          "minLength": 3
        },
        "subtitle": {
          "type": "string",
          "description": "One line",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "2-4 sentences",
          "maxLength": 4000
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "citations"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "Measurable objective, starts with an action verb",
                "maxLength": 400,
                "minLength": 3
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^frg_[a-z2-7]{12}$",
                  "description": "A fragment id from the source"
                },
                "minItems": 1,
                "maxItems": 6,
                "description": "Fragment ids the item is based on"
              }
            }
          },
          "minItems": 1,
          "maxItems": 6
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "lessons"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Module title",
            "maxLength": 200,
            "minLength": 2
          },
          "summary": {
            "type": "string",
            "description": "One sentence",
            "maxLength": 600
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "summary",
                "minutes",
                "objectives",
                "citations"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Lesson title",
                  "maxLength": 200,
                  "minLength": 2
                },
                "summary": {
                  "type": "string",
                  "description": "One sentence",
                  "maxLength": 600
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "objectives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "citations"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "description": "Measurable objective, starts with an action verb",
                        "maxLength": 400,
                        "minLength": 3
                      },
                      "citations": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^frg_[a-z2-7]{12}$",
                          "description": "A fragment id from the source"
                        },
                        "minItems": 1,
                        "maxItems": 6,
                        "description": "Fragment ids the item is based on"
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 3
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^frg_[a-z2-7]{12}$",
                    "description": "A fragment id from the source"
                  },
                  "minItems": 1,
                  "maxItems": 6,
                  "description": "Fragment ids the item is based on"
                }
              }
            },
            "minItems": 1,
            "maxItems": 5
          }
        }
      },
      "minItems": 1,
      "maxItems": 5
    }
  }
}
