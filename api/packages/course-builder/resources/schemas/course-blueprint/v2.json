{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/course-blueprint/v2.json",
  "title": "Course Blueprint v2",
  "description": "One version of a course built by the Course Builder (ADR 0010, 0050). v2 reads every v1 document unchanged (only schemaVersion differs) and adds lesson content types (richtext, liascript, h5p, interactive) with optional selfChecks and interaction. Element ids are ULIDs assigned by server code; citations are fragment ids of the session's sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources",
    "course",
    "modules",
    "finalTest",
    "pages"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "fragmentId": {
      "type": "string",
      "pattern": "^frg_[a-z2-7]{12}$"
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fragmentId"
      },
      "maxItems": 20
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "citations": {
          "$ref": "#/$defs/citations"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "markdown",
        "citations",
        "objectiveIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "paragraph",
            "callout",
            "steps",
            "code",
            "table",
            "example"
          ]
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "citations": {
          "$ref": "#/$defs/citations",
          "minItems": 1
        },
        "objectiveIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "correct"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "correct": {
          "type": "boolean"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "stem",
        "options",
        "explanation",
        "citations",
        "objectiveIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "single",
            "multiple",
            "truefalse",
            "short"
          ]
        },
        "stem": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "explanation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "citations": {
          "$ref": "#/$defs/citations",
          "minItems": 1
        },
        "objectiveIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "questions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "passScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "maxItems": 50
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "minutes",
        "objectives",
        "citations",
        "contentType",
        "status",
        "blocks",
        "quiz",
        "flags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "citations": {
          "$ref": "#/$defs/citations",
          "minItems": 1
        },
        "contentType": {
          "type": "string",
          "enum": [
            "richtext",
            "liascript",
            "h5p",
            "interactive"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "generated",
            "failed"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 60
        },
        "quiz": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/quiz"
            }
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 20
        },
        "selfChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "maxItems": 6,
          "description": "LiaScript lessons: inline questions after the text (rendered as LiaScript quizzes)"
        },
        "interaction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/interaction"
            }
          ],
          "description": "h5p and interactive lessons: the interaction that follows the text"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          },
          "minItems": 1,
          "maxItems": 30
        }
      }
    },
    "h5pLibrary": {
      "type": "string",
      "enum": [
        "H5P.Blanks",
        "H5P.DragText",
        "H5P.Dialogcards"
      ]
    },
    "interaction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "library",
            "title",
            "data",
            "citations",
            "objectiveIds"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "h5p"
            },
            "library": {
              "$ref": "#/$defs/h5pLibrary"
            },
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "data": {
              "type": "object",
              "description": "The fields of the library's own schema (resources/schemas/h5p/<library>.json), mapped to H5P parameters by our code"
            },
            "citations": {
              "$ref": "#/$defs/citations",
              "minItems": 1
            },
            "objectiveIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "packageId",
            "title",
            "caption",
            "citations",
            "objectiveIds"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "interactive"
            },
            "packageId": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "startStep": {
              "type": "string",
              "maxLength": 64
            },
            "endStep": {
              "type": "string",
              "maxLength": 64
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Markdown shown beside the interactive"
            },
            "citations": {
              "$ref": "#/$defs/citations",
              "minItems": 1
            },
            "objectiveIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "fragmentCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fragmentCount": {
            "type": "integer"
          }
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language",
        "objectives"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 70
            },
            "description": {
              "type": "string",
              "maxLength": 160
            }
          }
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "audience": {
          "type": "string",
          "maxLength": 300
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          },
          "maxItems": 12
        },
        "faq": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer",
              "citations"
            ],
            "properties": {
              "question": {
                "type": "string",
                "maxLength": 300
              },
              "answer": {
                "type": "string",
                "maxLength": 2000
              },
              "citations": {
                "$ref": "#/$defs/citations"
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "finalTest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/quiz"
        }
      ]
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landing": {
          "type": [
            "object",
            "null"
          ]
        },
        "header": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
