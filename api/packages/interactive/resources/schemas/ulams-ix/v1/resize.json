{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-ix/v1/resize.json",
  "title": "resize",
  "description": "Package to parent.",
  "type": "object",
  "required": [
    "ulams-ix",
    "type",
    "nonce",
    "height"
  ],
  "properties": {
    "ulams-ix": {
      "const": 1
    },
    "type": {
      "const": "resize"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "height": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    }
  },
  "additionalProperties": false
}
