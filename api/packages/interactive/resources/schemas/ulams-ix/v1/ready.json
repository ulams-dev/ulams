{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-ix/v1/ready.json",
  "title": "ready",
  "description": "Package to parent. Answers init.",
  "type": "object",
  "required": [
    "ulams-ix",
    "type",
    "nonce",
    "protocol",
    "steps",
    "capabilities"
  ],
  "properties": {
    "ulams-ix": {
      "const": 1
    },
    "type": {
      "const": "ready"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "protocol": {
      "const": 1
    },
    "steps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "score": {
          "type": "boolean"
        },
        "background": {
          "type": "boolean"
        },
        "locales": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
