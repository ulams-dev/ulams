{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-ix/v1/loadExercise.json",
  "title": "loadExercise",
  "description": "Parent to runner (code exercises, ADR 0170). The exercise's visible tests and limits. Messages of this type may be up to 640 KB.",
  "type": "object",
  "required": [
    "ulams-ix",
    "type",
    "nonce",
    "language",
    "tests",
    "timeoutMs"
  ],
  "properties": {
    "ulams-ix": {
      "const": 1
    },
    "type": {
      "const": "loadExercise"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "language": {
      "enum": [
        "javascript",
        "typescript"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,79}$"
          },
          "content": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "additionalProperties": false
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 30000
    }
  },
  "additionalProperties": false
}
