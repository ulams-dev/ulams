{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/report-definition/v1.json",
  "title": "Report definition v1",
  "description": "What a report asks of one dataset: columns or groups with aggregates, filters, a date range, a sort and a limit. Column names are checked against the dataset's declared columns, never used as SQL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset"],
  "properties": {
    "version": { "const": 1 },
    "dataset": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "columns": {
      "description": "Row-level report: the columns to list. Omit it for a grouped report.",
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/columnName" }
    },
    "filters": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/filter" }
    },
    "dateRange": { "$ref": "#/$defs/dateRange" },
    "groupBy": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/columnName" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["column", "bucket"],
            "properties": {
              "column": { "$ref": "#/$defs/columnName" },
              "bucket": { "enum": ["day", "week", "month", "quarter", "year"] }
            }
          }
        ]
      }
    },
    "aggregates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fn", "as"],
        "properties": {
          "fn": { "enum": ["count", "count_distinct", "sum", "avg", "min", "max"] },
          "column": { "$ref": "#/$defs/columnName" },
          "as": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }
        }
      }
    },
    "sort": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column"],
        "properties": {
          "column": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 80 },
          "dir": { "enum": ["asc", "desc"] }
        }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000000 }
  },
  "$defs": {
    "columnName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 255 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "op"],
      "properties": {
        "column": { "$ref": "#/$defs/columnName" },
        "op": { "enum": ["eq", "neq", "in", "not_in", "lt", "lte", "gt", "gte", "between", "contains", "is_null"] },
        "value": true
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["in", "not_in"] } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/scalar" } } } }
        },
        {
          "if": { "properties": { "op": { "const": "between" } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/scalar" } } } }
        },
        {
          "if": { "properties": { "op": { "enum": ["eq", "neq", "lt", "lte", "gt", "gte", "contains"] } } },
          "then": { "required": ["value"], "properties": { "value": { "$ref": "#/$defs/scalar" } } }
        },
        {
          "if": { "properties": { "op": { "const": "is_null" } } },
          "then": { "properties": { "value": { "type": "boolean" } } }
        }
      ]
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column"],
      "properties": {
        "column": { "$ref": "#/$defs/columnName" },
        "preset": { "enum": ["last_7_days", "last_30_days", "last_90_days", "last_12_months", "this_month", "last_month", "this_quarter", "this_year", "last_year"] },
        "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
