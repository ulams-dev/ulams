{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/webhooks/2026-10-20/event.json",
  "title": "ulams webhook event, api_version 2026-10-20",
  "description": "The JSON body of every outgoing webhook request for endpoints pinned to api_version 2026-10-20. Later versions only add fields; receivers must ignore fields they do not know. `id` identifies the event (a retry or replay carries the same id), `created` is the time the event was recorded in unix seconds.",
  "type": "object",
  "required": ["id", "object", "type", "api_version", "created", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[0-9a-z]{26}$" },
    "object": { "const": "event" },
    "api_version": { "const": "2026-10-20" },
    "created": { "type": "integer", "minimum": 0 },
    "type": {
      "enum": ["course.completed", "enrolment.created", "update_proposal.ready", "update_proposal.applied", "certificate.issued", "knowledge.exported", "training.assigned", "training.completed", "training.overdue", "path.completed", "certificate.revoked", "webhook.test"]
    },
    "data": {
      "type": "object",
      "required": ["object"],
      "properties": { "object": { "type": "object" } }
    }
  },
  "oneOf": [
    {
      "properties": { "type": { "const": "course.completed" }, "data": { "properties": { "object": { "$ref": "#/$defs/courseCompleted" } } } }
    },
    {
      "properties": { "type": { "const": "enrolment.created" }, "data": { "properties": { "object": { "$ref": "#/$defs/enrolmentCreated" } } } }
    },
    {
      "properties": { "type": { "const": "update_proposal.ready" }, "data": { "properties": { "object": { "$ref": "#/$defs/updateProposalReady" } } } }
    },
    {
      "properties": { "type": { "const": "update_proposal.applied" }, "data": { "properties": { "object": { "$ref": "#/$defs/updateProposalApplied" } } } }
    },
    {
      "properties": { "type": { "const": "certificate.issued" }, "data": { "properties": { "object": { "$ref": "#/$defs/certificateIssued" } } } }
    },
    {
      "properties": { "type": { "const": "knowledge.exported" }, "data": { "properties": { "object": { "$ref": "#/$defs/knowledgeExported" } } } }
    },
    {
      "properties": { "type": { "const": "training.assigned" }, "data": { "properties": { "object": { "$ref": "#/$defs/trainingAssigned" } } } }
    },
    {
      "properties": { "type": { "const": "training.completed" }, "data": { "properties": { "object": { "$ref": "#/$defs/trainingCompleted" } } } }
    },
    {
      "properties": { "type": { "const": "training.overdue" }, "data": { "properties": { "object": { "$ref": "#/$defs/trainingOverdue" } } } }
    },
    {
      "properties": { "type": { "const": "path.completed" }, "data": { "properties": { "object": { "$ref": "#/$defs/pathCompleted" } } } }
    },
    {
      "properties": { "type": { "const": "certificate.revoked" }, "data": { "properties": { "object": { "$ref": "#/$defs/certificateRevoked" } } } }
    },
    {
      "properties": { "type": { "const": "webhook.test" }, "data": { "properties": { "object": { "$ref": "#/$defs/test" } } } }
    }
  ],
  "$defs": {
    "user": {
      "type": "object",
      "required": ["id", "email", "name"],
      "properties": {
        "id": { "type": "integer" },
        "email": { "type": ["string", "null"] },
        "name": { "type": "string" }
      }
    },
    "course": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": "string" }
      }
    },
    "courseCompleted": {
      "type": "object",
      "required": ["user", "course", "completed_at"],
      "properties": {
        "user": { "$ref": "#/$defs/user" },
        "course": { "$ref": "#/$defs/course" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "enrolmentCreated": {
      "type": "object",
      "required": ["user", "course", "created_at"],
      "properties": {
        "user": { "$ref": "#/$defs/user" },
        "course": { "$ref": "#/$defs/course" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "updateProposalReady": {
      "type": "object",
      "required": ["proposal_id", "session_id", "course_title", "elements", "answer_checks", "status"],
      "properties": {
        "proposal_id": { "type": "string" },
        "session_id": { "type": "string" },
        "course_title": { "type": "string" },
        "elements": { "type": "integer", "minimum": 0 },
        "answer_checks": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["ready", "awaiting_analysis", "budget_blocked"] }
      }
    },
    "updateProposalApplied": {
      "type": "object",
      "required": ["proposal_id", "session_id", "number", "status", "counts"],
      "properties": {
        "proposal_id": { "type": "string" },
        "session_id": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "counts": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "certificateIssued": {
      "type": "object",
      "required": ["user", "certificate_id", "course_id", "issued_at"],
      "properties": {
        "user": { "$ref": "#/$defs/user" },
        "certificate_id": { "type": ["integer", "string"] },
        "course_id": { "type": ["integer", "string"] },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    },
    "knowledgeExported": {
      "type": "object",
      "required": ["export_id", "scope", "course_id", "trigger", "pack_hash", "courses", "chunks", "uncited_chunks", "finished_at"],
      "properties": {
        "export_id": { "type": "string" },
        "scope": { "enum": ["course", "tenant"] },
        "course_id": { "type": ["integer", "null"] },
        "trigger": { "enum": ["manual", "auto"] },
        "pack_hash": { "type": "string" },
        "courses": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "integer", "minimum": 0 },
        "uncited_chunks": { "type": "integer", "minimum": 0 },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "trainingPath": {
      "description": "The learning path step this required course is, or null when it is not a step of a path the learner is enrolled in.",
      "type": ["object", "null"],
      "required": ["id", "title", "step", "steps"],
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": "string" },
        "step": { "type": "integer", "minimum": 1 },
        "steps": { "type": "integer", "minimum": 1 }
      }
    },
    "training": {
      "type": "object",
      "required": ["user", "course", "assignment_id", "source", "due_at", "path"],
      "properties": {
        "user": { "$ref": "#/$defs/user" },
        "course": { "$ref": "#/$defs/course" },
        "assignment_id": { "type": "integer" },
        "source": { "enum": ["manual", "rule", "recertification"] },
        "due_at": { "type": ["string", "null"], "format": "date-time" },
        "path": { "$ref": "#/$defs/trainingPath" }
      }
    },
    "trainingAssigned": {
      "allOf": [{ "$ref": "#/$defs/training" }],
      "required": ["assigned_at"],
      "properties": { "assigned_at": { "type": "string", "format": "date-time" } }
    },
    "trainingCompleted": {
      "allOf": [{ "$ref": "#/$defs/training" }],
      "required": ["completed_at", "certificate_id"],
      "properties": {
        "completed_at": { "type": "string", "format": "date-time" },
        "certificate_id": { "type": ["integer", "string", "null"] }
      }
    },
    "trainingOverdue": {
      "allOf": [{ "$ref": "#/$defs/training" }],
      "required": ["due_at"],
      "properties": { "due_at": { "type": "string", "format": "date-time" } }
    },
    "pathCompleted": {
      "type": "object",
      "required": ["user", "path", "enrollment_id", "completed_at"],
      "properties": {
        "user": { "$ref": "#/$defs/user" },
        "path": {
          "type": "object",
          "required": ["id", "title", "steps"],
          "properties": {
            "id": { "type": "integer" },
            "title": { "type": "string" },
            "steps": { "type": "integer", "minimum": 0 }
          }
        },
        "enrollment_id": { "type": "integer" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "certificateRevoked": {
      "type": "object",
      "required": ["user", "certificate_id", "course_id", "revoked_at", "reason"],
      "properties": {
        "user": { "$ref": "#/$defs/user" },
        "certificate_id": { "type": ["integer", "string"] },
        "course_id": { "type": ["integer", "string"] },
        "revoked_at": { "type": "string", "format": "date-time" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "test": {
      "type": "object",
      "properties": { "test": { "const": true } }
    }
  }
}
