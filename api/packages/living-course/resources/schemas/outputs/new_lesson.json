{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/living-course/new-lesson-output.json",
  "title": "A suggested lesson for source sections no lesson covers",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "moduleTitle", "title", "summary", "minutes", "objectives", "blocks", "reply"],
  "$defs": {
    "fragmentId": { "type": "string", "pattern": "^frg_[a-z2-7]{12}$" },
    "citations": { "type": "array", "items": { "$ref": "#/$defs/fragmentId" }, "minItems": 1, "maxItems": 6 }
  },
  "properties": {
    "moduleId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-z]{26}$" }] },
    "moduleTitle": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 2, "maxLength": 200 }] },
    "title": { "type": "string", "minLength": 2, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 600 },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "citations"],
        "properties": {
          "text": { "type": "string", "minLength": 3, "maxLength": 400 },
          "citations": { "$ref": "#/$defs/citations" }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "markdown", "citations", "objectiveIndexes"],
        "properties": {
          "kind": { "type": "string", "enum": ["paragraph", "callout", "steps", "code", "table", "example"] },
          "markdown": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "citations": { "$ref": "#/$defs/citations" },
          "objectiveIndexes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 2 }, "minItems": 1, "maxItems": 3 }
        }
      }
    },
    "reply": { "type": "string", "minLength": 1, "maxLength": 400 }
  }
}
