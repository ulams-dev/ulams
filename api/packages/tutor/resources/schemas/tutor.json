{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course tutor answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "citations", "in_scope", "refusal"],
  "properties": {
    "answer": {"type": "string", "minLength": 1, "maxLength": 1200},
    "citations": {"type": "array", "maxItems": 6, "items": {"type": "string", "pattern": "^c[0-9]+$"}},
    "in_scope": {"type": "boolean"},
    "refusal": {"type": "string", "enum": ["none", "out_of_scope", "attempt_active", "unsafe"]}
  }
}
