{
    "name": "api-h5p",
    "version": "0.1.0",
    "private": true,
    "description": "H5P microservice (Lumi h5p-nodejs-library) for the Ulams LMS",
    "license": "GPL-3.0-or-later",
    "type": "commonjs",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json && node scripts/build-embed.mjs",
        "start": "node dist/index.js",
        "seed": "node dist/cli/seed.js",
        "seed:dev": "tsx src/cli/seed.ts",
        "download:core": "sh scripts/download-core.sh",
        "test": "vitest run --exclude test/http.test.ts --exclude test/pg-storage.test.ts",
        "test:integration": "vitest run test/http.test.ts test/pg-storage.test.ts",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p embed-client/tsconfig.json",
        "lint": "eslint src test embed-client && tsc -p tsconfig.json --noEmit && tsc -p embed-client/tsconfig.json",
        "build:embed": "node scripts/build-embed.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1147.0",
        "@aws-sdk/lib-storage": "3.1147.0",
        "@lumieducation/h5p-express": "10.0.5",
        "@lumieducation/h5p-redis-lock": "10.0.4",
        "@lumieducation/h5p-server": "10.0.4",
        "@lumieducation/h5p-svg-sanitizer": "10.0.4",
        "cors": "2.8.6",
        "express": "5.2.1",
        "express-fileupload": "1.5.2",
        "i18next": "26.4.2",
        "i18next-fs-backend": "2.6.8",
        "i18next-http-middleware": "3.9.9",
        "jose": "6.2.12",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "redis": "4.7.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@lumieducation/h5p-webcomponents": "10.0.4",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/express-fileupload": "1.5.1",
        "@types/node": "22.20.5",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "esbuild": "0.28.2",
        "eslint": "9.39.5",
        "supertest": "7.3.1",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.1",
        "vite": "8.3.3",
        "vitest": "5.0.3"
    }
}
