# Redis key prefixes; tenants get ulams_<slug>_ from ulams:tenant:create
#REDIS_PREFIX=ulams_database_
#CACHE_PREFIX=ulams_cache
#HORIZON_PREFIX=ulams_horizon:

# Tenancy (packages/tenancy). DEV ONLY: password of every demo user created by
# `php artisan ulams:tenant:create`. Never use the default outside local development.
TENANT_DEMO_PASSWORD=secret
# Superuser connection used to create tenant roles/databases (defaults to DB_*)
#DB_ADMIN_USERNAME=default
#DB_ADMIN_PASSWORD=secret
# Demo mode (packages/demo) is set per tenant: `ulams:tenant:create <slug> --demo=on` writes
# DEMO_MODE=true to its .env.<host>. Keep it off on the platform.
#DEMO_MODE=false
# Hosts served by the platform .env; any other host that is not a tenant gets a 404
#TENANCY_PLATFORM_HOSTS=api.localhost,localhost,127.0.0.1,caddy,api


# LLM layer (packages/ai, ADR 0009). AI_DRIVER: anthropic | fake | disabled. Without a key the
# anthropic driver is disabled and every builder endpoint answers 503; the LMS keeps working.
AI_DRIVER=anthropic
ANTHROPIC_API_KEY=
#AI_MODEL_DEFAULT=claude-sonnet-5-5
#AI_MODEL_LIGHT=claude-haiku-5-5
#AI_MODEL_PREMIUM=claude-opus-5-5
# Switch one task to the opt-in premium profile, e.g. AI_TASK_OUTLINE_PROFILE=premium
#AI_CACHE_TTL=1h
#AI_LIMIT_SUBJECT_COST_USD=5
#AI_LIMIT_SUBJECT_TOKENS=3000000
#AI_LIMIT_TENANT_MONTHLY_USD=50
# Fake driver: cassette (replay only) | synthetic (replay, else deterministic stand-ins)
#AI_FAKE_MODE=synthetic
#AI_CASSETTES_PATH=
