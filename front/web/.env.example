# Reference frontend (front/web). Copy to .env for local overrides; .env is git-ignored.

# Tenant host rules: "<front host pattern>=><API URL template>", comma separated, first match wins.
ULAMS_TENANT_HOSTS={slug}.app.localhost=>http://{slug}.localhost
# Admin panel of a tenant ("Demo" badge link).
ULAMS_ADMIN_URL=http://{slug}.admin.localhost
# Hosts (port ignored) that serve the platform product landing instead of a tenant.
ULAMS_PLATFORM_HOSTS=app.localhost,localhost,127.0.0.1
# Demo tenants shown on the platform landing (learner and admin buttons).
ULAMS_DEMO_TENANTS=coffee,oncall,nightsky
# Tenant used on other hosts without a rule (e.g. a LAN IP). Empty = show the tenant picker.
ULAMS_DEFAULT_TENANT=coffee
# Server-side cache of public API data (settings, courses, tutors, events), in seconds.
ULAMS_CACHE_TTL=45
# Tenants whose public data is fetched when the server starts (comma separated slugs).
ULAMS_WARM_TENANTS=coffee,oncall,nightsky

# Session cookies are `__Host-ulams_session` / `__Host-ulams_author` (Secure, Path=/, no Domain) on
# https, so a content origin on a sibling subdomain cannot set or shadow them (ADR 0014, amended).
# `auto` detects https from the request / X-Forwarded-Proto; set `true` when a proxy does not forward
# the protocol, `false` only for a plain-http trial install (the prefix is then dropped).
ULAMS_COOKIE_SECURE=auto
# Name prefix used instead of `__Host-` over plain http (development on *.localhost); empty = bare name.
ULAMS_COOKIE_FALLBACK_PREFIX=

# Demo login. POST /api/demo/login is used when the tenant has demo mode; otherwise the server
# logs in with this account. {slug} is replaced with the tenant slug. Set the password from
# TENANT_DEMO_PASSWORD (api/.env); never commit it.
DEMO_STUDENT_EMAIL=student1@{slug}.ulams.app
DEMO_STUDENT_PASSWORD=
