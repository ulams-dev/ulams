---
/**
 * Page shell: tenant theme (CSS custom properties inlined, no extra request), self-hosted
 * fonts with metric-matched fallbacks, skip link, demo badge and the scroll-reveal script.
 */
import { Font } from "astro:assets";
import baseCss from "@ulams/ui/styles/base.css?inline";
import fallbackCss from "@ulams/ui/styles/fallbacks.css?inline";
import coffeeCss from "@ulams/ui/styles/themes/coffee.css?inline";
import oncallCss from "@ulams/ui/styles/themes/oncall.css?inline";
import nightskyCss from "@ulams/ui/styles/themes/nightsky.css?inline";
import gravityCss from "@ulams/ui/styles/themes/gravity.css?inline";
import polandCss from "@ulams/ui/styles/themes/poland.css?inline";
import ulamCss from "@ulams/ui/styles/themes/ulam.css?inline";
import platformCss from "@ulams/ui/styles/themes/platform.css?inline";
import type { ThemeName } from "@ulams/ui/registry";
import DemoBadge from "../components/DemoBadge.astro";
import { THEME_COLOR } from "../lib/theme.ts";
import { accentCss } from "../lib/accent.ts";
import { uiStrings } from "@ulams/ui/i18n";

interface Props {
  theme: ThemeName;
  title: string;
  description?: string;
  lang?: string;
  /** Show the demo badge (tenant admin link, other demos). */
  demo?: { adminUrl: string; slug: string } | null;
  /** Extra class on <body>. */
  bodyClass?: string;
  /** Tenant accent colour from API settings (`theme.accent`); applied as CSS variables. */
  accent?: string | null;
  /** Keep the page out of search engines (the author preview). */
  noindex?: boolean;
  /** Canonical URL of the page, and its language alternates (hreflang); the platform landing in each language. */
  canonical?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Open Graph locale (en_US, pl_PL, zh_CN). */
  ogLocale?: string;
  /** Default target of links (`_top` inside the studio's preview frame). */
  baseTarget?: string;
}

const { theme, title, description, lang = "en", demo, bodyClass, accent, noindex = false, baseTarget, canonical, alternates = [], ogLocale } = Astro.props;
const t = uiStrings(lang);
const tenantCss = accentCss(theme, accent);
const themeCss = { coffee: coffeeCss, oncall: oncallCss, nightsky: nightskyCss, gravity: gravityCss, poland: polandCss, ulam: ulamCss, platform: platformCss }[theme];
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {baseTarget && <base target={baseTarget} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="theme-color" content={THEME_COLOR[theme]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      theme === "platform" && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="ulams" />
          {ogLocale && <meta property="og:locale" content={ogLocale} />}
          {canonical && <meta property="og:url" content={canonical} />}
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:image" content={new URL("/og-image.png", Astro.url).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="ulams, living courses from real sources" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {
      theme === "coffee" && (
        <>
          <Font cssVariable="--font-playfair" preload={[{ weight: "400", style: "normal" }]} />
          <Font cssVariable="--font-jakarta" preload={[{ weight: "400" }]} />
        </>
      )
    }
    {
      theme === "oncall" && (
        <>
          <Font cssVariable="--font-space-grotesk" preload={[{ weight: "600" }]} />
          <Font cssVariable="--font-inter" preload={[{ weight: "400" }]} />
          <Font cssVariable="--font-jetbrains" preload={[{ weight: "400" }]} />
        </>
      )
    }
    {
      theme === "gravity" && (
        <>
          <Font cssVariable="--font-space-grotesk" preload={[{ weight: "600" }]} />
          <Font cssVariable="--font-inter" preload={[{ weight: "400" }]} />
          <Font cssVariable="--font-jetbrains" />
        </>
      )
    }
    {
      theme === "poland" && (
        <>
          <Font cssVariable="--font-source-serif" preload={[{ weight: "600" }]} />
          <Font cssVariable="--font-plex-sans" preload={[{ weight: "400" }]} />
          <Font cssVariable="--font-plex-mono" />
        </>
      )
    }
    {
      theme === "ulam" && (
        <>
          <Font cssVariable="--font-eb-garamond" preload={[{ weight: "500" }]} />
          <Font cssVariable="--font-plex-sans" preload={[{ weight: "400" }]} />
          <Font cssVariable="--font-plex-mono" />
        </>
      )
    }
    {
      theme === "platform" && (
        <>
          <Font cssVariable="--font-inter-tight" preload={[{ weight: "600" }]} />
          <Font cssVariable="--font-inter" preload={[{ weight: "400" }]} />
          <Font cssVariable="--font-jetbrains" />
        </>
      )
    }
    {
      theme === "nightsky" && (
        <>
          <Font cssVariable="--font-comfortaa" preload={[{ weight: "700" }]} />
          <Font cssVariable="--font-quicksand" preload={[{ weight: "500" }]} />
        </>
      )
    }
    <style is:inline set:html={fallbackCss + baseCss + themeCss + tenantCss}></style>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="u-skip" href="#main">{t.skip}</a>
    <slot />
    {demo && <DemoBadge adminUrl={demo.adminUrl} slug={demo.slug} />}
    <script>
      import { initReveal } from "@ulams/ui/elements/reveal.ts";
      import { initNavigationProgress } from "@ulams/ui/elements/navigation.ts";
      initReveal();
      initNavigationProgress();
    </script>
  </body>
</html>
