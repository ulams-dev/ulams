---
/** Reporting: who sees which report. Static on purpose: a reference table, not a story. */
import DiagramFrame from "./DiagramFrame.astro";
import type { RolesCopy } from "../../lib/impact-diagrams.ts";

interface Props {
  copy: RolesCopy;
}
const { copy } = Astro.props;
const ICONS = [
  "M4 16.5V14l8.5-8.5 2.5 2.5L6.5 16.5H4zM11 7l2.5 2.5",
  "M10 3l6 2.5v4c0 3.7-2.6 6.4-6 7.5-3.4-1.1-6-3.8-6-7.5v-4L10 3z",
  "M5 3.5h7l3 3v10H5v-13zM12 3.5v3h3M7.5 10.5l2 2 3.5-3.5",
  "M3.5 5.5h13v9h-13v-9zM3.5 6l6.5 5 6.5-5",
  "M6.5 6L3 10l3.5 4M13.5 6L17 10l-3.5 4M11.5 4.5l-3 11",
];
---

<DiagramFrame id="dg-roles" head={copy} tone="available" animated={false}>
  <ul class="dg-roles" role="list">
    {
      copy.roles.map((role, i) => (
        <li class="dg-roles__card">
          <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true">
            <path d={ICONS[i % ICONS.length]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h4 class="dg-roles__name">{role.name}</h4>
          <ul role="list">
            {role.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</DiagramFrame>
