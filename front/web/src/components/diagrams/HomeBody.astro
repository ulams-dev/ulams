---
/**
 * Body of the platform home page in one language: the page document rendered as usual, the product hero with the
 * L&D journey in its stage (HeroJourney, the ten-second overview), the "how it works" story
 * and the builder walkthrough right after the hero, and the style-guide section after the white-label band
 * (lib/home-story.ts `planHomeBody`). The main landmark is the one `Main` would render.
 */
import Render from "@ulams/ui/Render.astro";
import { uiStrings } from "@ulams/ui/i18n";
import type { UiNode } from "@ulams/ui/render-core";
import { LOCALE_META, type Locale } from "../../i18n/locales.ts";
import { homeStory, planHomeBody } from "../../lib/home-story.ts";
import HomeStory from "./HomeStory.astro";
import BuilderWalkthrough from "./BuilderWalkthrough.astro";
import HeroJourney from "./HeroJourney.astro";
import Hero from "@ulams/ui/components/Hero.astro";
import type { ComponentProps } from "astro/types";
import { heroJourneyCopy } from "../../lib/hero-journey.ts";
import StyleGuideSection from "../style-guide/StyleGuideSection.astro";
import LearningSection from "../learning/LearningSection.astro";
import { walkthroughCopy, walkthroughSteps } from "../../lib/builder-walkthrough.ts";

interface Props {
  doc: UiNode;
  data?: unknown;
  locale: Locale;
}

const { doc, data, locale } = Astro.props;
const plan = planHomeBody(doc);
const strings = uiStrings(LOCALE_META[locale].lang);
const status = { available: strings.available, coming: strings.coming };
const copy = homeStory(locale);
const walkthrough = walkthroughCopy(locale);
const steps = walkthroughSteps(locale);
const journey = heroJourneyCopy(locale);
type HeroProps = ComponentProps<typeof Hero>;
---

{
  plan ? (
    <>
      {plan.before.map((node) => <Render doc={node} data={data} />)}
      <main id="main" tabindex="-1" class="dg-main">
        {plan.main.map((part) =>
          part.kind === "node" && part.node.component === "Hero" && part.node.props?.variant === "product" ? (
            <Hero {...(part.node.props as unknown as HeroProps)}>
              <HeroJourney slot="journey" copy={journey} />
            </Hero>
          ) : part.kind === "node" ? (
            <Render doc={part.node} data={data} />
          ) : part.kind === "story" ? (
            <HomeStory copy={copy} status={status} />
          ) : part.kind === "walkthrough" ? (
            <BuilderWalkthrough copy={walkthrough} steps={steps} locale={locale} />
          ) : part.kind === "learning" ? (
            <LearningSection locale={locale} />
          ) : (
            <StyleGuideSection locale={locale} />
          ),
        )}
      </main>
      {plan.after.map((node) => <Render doc={node} data={data} />)}
    </>
  ) : (
    <Render doc={doc} data={data} />
  )
}
