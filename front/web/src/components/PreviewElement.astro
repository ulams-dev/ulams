---
/**
 * One element of the studio's interactive preview: the content as the learner sees it, marked with
 * the blueprint id the element chat addresses. A real "Discuss" button (Tab, Enter) opens the chat
 * for the element; the studio island also selects it when the element itself is clicked. The
 * button shows on hover, on keyboard focus and when the element is selected.
 */
interface Props {
  /** Blueprint element id (`data-blueprint-id`). */
  id: string;
  /** Human label: "Lesson 1.2 › block 3". */
  label: string;
  type: "course" | "module" | "lesson" | "block" | "question";
  /** Which part of the page it is, when the id alone is not unique (landing sections). */
  part?: string;
}
const { id, label, type, part } = Astro.props;
---

<div class="u-bp" data-blueprint-id={id} data-blueprint-type={type} data-blueprint-part={part} data-label={label}>
  <button type="button" class="u-bp__discuss" data-discuss aria-label={`Discuss: ${label}`} aria-pressed="false">
    <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3 4h14v9H8l-4 3v-3H3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
    <span>Discuss</span>
  </button>
  <slot />
</div>

<style is:global>
  .u-bp {
    position: relative;
    border-radius: var(--ulams-radius, 8px);
    outline: 2px solid transparent;
    outline-offset: 6px;
    transition: outline-color 0.15s, background-color 0.4s;
    cursor: pointer;
  }
  .u-bp:hover {
    outline-color: color-mix(in srgb, var(--ulams-color-primary, #5b5bd6) 55%, transparent);
    outline-style: dashed;
  }
  .u-bp[data-selected="true"] {
    outline: 2px solid var(--ulams-color-primary, #5b5bd6);
    outline-offset: 6px;
  }
  .u-bp.is-changed {
    background: color-mix(in srgb, var(--ulams-color-warn, #f6c453) 28%, transparent);
    outline: 2px solid var(--ulams-color-warn, #f6c453);
    outline-offset: 6px;
  }
  .u-bp__discuss {
    position: absolute;
    top: -14px;
    right: 0;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 4px 12px;
    border: 1px solid var(--ulams-color-primary, #5b5bd6);
    border-radius: 999px;
    background: var(--ulams-color-primary, #5b5bd6);
    color: var(--ulams-color-on-primary, #fff);
    font: 600 0.8125rem/1 var(--ulams-font-family-body, system-ui, sans-serif);
    cursor: pointer;
    opacity: 0;
    transform: translateY(2px);
    transition: opacity 0.15s, transform 0.15s;
  }
  .u-bp:hover > .u-bp__discuss,
  .u-bp:focus-within > .u-bp__discuss,
  .u-bp[data-selected="true"] > .u-bp__discuss,
  .u-bp__discuss:focus-visible {
    opacity: 1;
    transform: none;
  }
  .u-bp__discuss:focus-visible {
    outline: 3px solid var(--ulams-color-text, #111);
    outline-offset: 2px;
  }
  .u-bp[data-selected="true"] > .u-bp__discuss {
    background: var(--ulams-color-bg, #fff);
    color: var(--ulams-color-primary-on-light, var(--ulams-color-primary, #5b5bd6));
  }
  @media (hover: none) {
    .u-bp__discuss {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .u-bp,
    .u-bp__discuss {
      transition: none;
    }
  }
</style>
