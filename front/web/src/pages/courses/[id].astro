---
import Render from "@ulams/ui/Render.astro";
import Base from "../../layouts/Base.astro";
import type { UiNode } from "@ulams/ui/render-core";
import { getCourse, getLearnerNotices, getProgram, getSiteModel, getSettings } from "../../lib/data.ts";
import { courseUpdatesDoc, NO_NOTICES, type LearnerNotices } from "../../lib/notices.ts";
import { chromeFor, withSessionLink } from "../../lib/docs.ts";
import { courseHeaderDoc, descriptionDoc, purchaseDoc, syllabusDoc } from "../../lib/page-docs.ts";
import { themeFor } from "../../lib/theme.ts";
import { completionPercent, flattenTopics, resumeTopic } from "@ulams/sdk";
import { lessonModels, topicHref } from "../../lib/view-model.ts";
import { readSession } from "../../lib/session.ts";

const tenant = Astro.locals.tenant;
if (!tenant) return Astro.redirect("/tenants");
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.rewrite("/404");

const [site, settings] = await Promise.all([getSiteModel(tenant, id), getSettings(tenant).catch(() => null)]);
const course = site.course;
if (!course || course.id !== id) {
  // unknown course: make sure it is not just missing from the list
  const exists = await getCourse(tenant, id).catch(() => null);
  if (!exists) return Astro.rewrite("/404");
}
const theme = themeFor(settings?.theme?.theme, tenant.slug);
const chrome = chromeFor(theme);

// Returning learners (session cookie present) see their progress; others get the public page.
const token = readSession(Astro.cookies, Astro.locals.secure);
let progress: number | undefined;
let resumeHref = course!.learnHref;
let updatesDoc: UiNode | null = null;
if (token) {
  const program = await Promise.race([
    getProgram(tenant, token, id).catch(() => null),
    new Promise<null>((r) => setTimeout(() => r(null), 900)),
  ]);
  if (program?.access) {
    progress = completionPercent(program.course, program.progress);
    const next = resumeTopic(program.course, program.progress);
    if (next) resumeHref = topicHref(id, next.id);
    course!.lessons = lessonModels(program.course, { progress: program.progress });
    // Living Course: what changed since the learner completed or started lessons.
    const learnerNotices = await Promise.race([getLearnerNotices(tenant, token, id), new Promise<LearnerNotices>((r) => setTimeout(() => r(NO_NOTICES), 900))]);
    const titles = new Map(flattenTopics(program.course).map((t) => [t.id, t.title] as const));
    updatesDoc = courseUpdatesDoc(learnerNotices, id, titles);
  }
}
const description = descriptionDoc(theme, course!);
---

<Base theme={theme} accent={settings?.theme?.accent} title={`${course!.title} — ${site.tenant.name}`} description={course!.summary?.slice(0, 160)} demo={{ adminUrl: tenant.adminUrl, slug: tenant.slug }}>
  {chrome.header && <Render doc={withSessionLink(chrome.header, Boolean(token))} data={site} />}
  <main id="main" tabindex="-1">
    <Render doc={courseHeaderDoc(theme, course!, progress, resumeHref)} data={site} />
    {updatesDoc && <Render doc={updatesDoc} />}
    <Render doc={syllabusDoc(theme, course!)} data={site} />
    <section class="u-container u-course-about" aria-label="About the course">
      <div class="u-course-about__text">
        {description && <Render doc={description} data={site} />}
      </div>
      <div class="u-course-about__side">
        <Render doc={purchaseDoc(course!, site, resumeHref)} data={site} />
      </div>
    </section>
  </main>
  {chrome.footer && <Render doc={chrome.footer} data={site} />}
</Base>

<style>
  main:focus {
    outline: none;
  }
  .u-course-about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .u-course-about {
      grid-template-columns: 1fr;
    }
    .u-course-about__side {
      order: -1;
    }
  }
</style>
