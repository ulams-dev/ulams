---
import Studio from "../../layouts/Studio.astro";
import { STYLE_LOCALES, STYLE_STRINGS, pickStyleLocale } from "../../studio/style-i18n.ts";

const tenant = Astro.locals.tenant;
if (!tenant) return Astro.redirect("/tenants");

const locale = pickStyleLocale(Astro.url.searchParams.get("lang"), Astro.request.headers.get("accept-language"));
const t = STYLE_STRINGS[locale];
const LANGUAGE_NAME: Record<string, string> = { en: "English", pl: "Polski", zh: "简体中文" };
---

<Studio title={t.pageTitle} crumb={t.pageTitle} active="style">
  <main id="main" class="st-page" tabindex="-1" lang={t.htmlLang}>
    <div class="st-ins-head">
      <h1 class="cb-serif cb-h2" style="flex:1">{t.heading}</h1>
      <nav class="st-ins-lang" aria-label={t.languageLabel}>
        {
          STYLE_LOCALES.map((code) => (
            <a href={`?lang=${code}`} lang={STYLE_STRINGS[code].htmlLang} hreflang={STYLE_STRINGS[code].htmlLang} aria-current={code === locale ? "true" : undefined}>
              {LANGUAGE_NAME[code]}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="cb-muted">{t.intro}</p>
    <div class="st-style" data-studio-style data-locale={locale} data-admin-url={tenant.adminUrl}>
      <p class="cb-muted" role="status">{t.loading}</p>
    </div>
    <noscript><p class="cb-error">{t.needsScript}</p></noscript>
  </main>
</Studio>

<script>
  import "../../studio/style.ts";
</script>
