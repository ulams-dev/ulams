---
import Studio from "../../../../layouts/Studio.astro";
import { courseTitleFor } from "../../../../lib/studio.ts";
import { COMPARE_LOCALES, COMPARE_STRINGS, fill, pickCompareLocale } from "../../../../studio/compare-i18n.ts";

const raw = Astro.params.courseId ?? "";
const tenant = Astro.locals.tenant;
if (!tenant) return Astro.redirect("/tenants");
if (!/^[1-9]\d{0,9}$/.test(raw)) return new Response("Not found", { status: 404 });
const courseId = Number(raw);

const locale = pickCompareLocale(Astro.url.searchParams.get("lang"), Astro.request.headers.get("accept-language"));
const t = COMPARE_STRINGS[locale];
const course = await courseTitleFor(tenant, Astro.locals.authorToken!, courseId);
if (!course.found) return new Response("Not found", { status: 404 });
const name = course.title ?? fill(t.courseFallback, { id: courseId });
// a version id or a release id: 26 letters and digits (the API answers 404 for an id that is not part of the course)
const idOf = (key: string): string => {
  const value = Astro.url.searchParams.get(key) ?? "";
  return /^[0-9A-Za-z]{26}$/.test(value) ? value : "";
};
const LANGUAGE_NAME: Record<string, string> = { en: "English", pl: "Polski", zh: "简体中文" };
const query = (code: string): string => {
  const q = new URLSearchParams({ lang: code });
  for (const key of ["from", "to"]) if (idOf(key)) q.set(key, idOf(key));
  return `?${q.toString()}`;
};
---

<Studio title={`${t.pageTitle}: ${name}`} crumb={name} active="versions" courseId={courseId}>
  <main id="main" class="st-page" tabindex="-1" lang={t.htmlLang}>
    <div class="st-ins-head">
      <h1 class="cb-serif cb-h2" style="flex:1">{t.heading}</h1>
      <nav class="st-ins-lang" aria-label={t.languageLabel}>
        {
          COMPARE_LOCALES.map((code) => (
            <a href={query(code)} lang={COMPARE_STRINGS[code].htmlLang} hreflang={COMPARE_STRINGS[code].htmlLang} aria-current={code === locale ? "true" : undefined}>
              {LANGUAGE_NAME[code]}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="cb-muted">{t.intro}</p>
    <div class="st-cmp" data-studio-compare data-course={courseId} data-locale={locale} data-from={idOf("from")} data-to={idOf("to")}>
      <p class="cb-muted" role="status">{t.loading}</p>
    </div>
    <noscript><p class="cb-error">{t.needsScript}</p></noscript>
  </main>
</Studio>

<script>
  import "../../../../studio/compare.ts";
</script>
