---
import Studio from "../../../../../layouts/Studio.astro";
import { ApiError, type BuilderState } from "@ulams/sdk";
import { builderFor } from "../../../../../lib/studio.ts";
import { STATUS_LABEL } from "../../../../../studio/labels.ts";

const id = Astro.params.id ?? "";
const proposal = Astro.params.proposal ?? "";
const tenant = Astro.locals.tenant;
if (!tenant) return Astro.redirect("/tenants");
if (!/^[0-9a-z]{26}$/.test(id) || !/^[0-9a-z]{26}$/.test(proposal)) return new Response("Not found", { status: 404 });

let state: BuilderState;
try {
  state = await builderFor(tenant, Astro.locals.authorToken!).sessions.get(id);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 403)) return new Response("Not found", { status: 404 });
  throw e;
}
---

<Studio
  title="Review a source update"
  crumb={state.session.title ?? "Updates"}
  status={STATUS_LABEL[state.session.status]}
  sessionId={id}
  active="updates"
  hasCourse={state.session.courseId !== null}
>
  <main id="main" class="st-page st-review" tabindex="-1">
    <p class="cb-small"><a href={`/studio/s/${id}/updates`}>All updates</a></p>
    <h1 class="cb-serif cb-h2">Review a source update</h1>
    <p class="cb-muted">
      The source of your course changed. Review what the AI proposes for each affected lesson. Nothing in the course changes until you
      accept the changes you want and apply them.
    </p>
    <div data-studio-review data-session={id} data-proposal={proposal}>
      <p class="cb-muted" role="status">Loading the update…</p>
    </div>
    <noscript><p class="cb-error">The review needs JavaScript to load the proposed changes.</p></noscript>
  </main>
</Studio>

<script>
  import "../../../../../studio/updates-review.ts";
</script>
