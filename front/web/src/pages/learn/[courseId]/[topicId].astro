---
/**
 * Lesson player route: loads the program for the learner session (logged in automatically as the
 * demo student by the middleware) and renders it with the shared player component.
 */
import LessonPlayer from "../../../components/LessonPlayer.astro";
import { getProgram, getSettings } from "../../../lib/data.ts";
import { renewSession } from "../../../lib/session.ts";
import { ApiError, flattenTopics } from "@ulams/sdk";

const tenant = Astro.locals.tenant;
const courseId = Number(Astro.params.courseId);
const topicId = Number(Astro.params.topicId);
if (!tenant || !Number.isInteger(courseId) || !Number.isInteger(topicId)) return Astro.rewrite("/404");
let token = Astro.locals.token;
if (!token) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);

const settingsP = getSettings(tenant).catch(() => null);
let program;
try {
  program = await getProgram(tenant, token, courseId);
} catch (error) {
  // Tokens die with the hourly demo reset: log in again once.
  if (error instanceof ApiError && error.status === 401) {
    token = await renewSession(tenant, Astro.cookies, Astro.locals.secure, token);
    if (!token) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
    program = await getProgram(tenant, token, courseId);
  } else if (error instanceof ApiError && error.status === 404) {
    return Astro.rewrite("/404");
  } else throw error;
}
if (!flattenTopics(program.course).some((t) => t.id === topicId)) return Astro.rewrite("/404");
const settings = await settingsP;
---

<LessonPlayer tenant={tenant} settings={settings} course={program.course} access={program.access} progress={program.progress} topicId={topicId} token={token} />
