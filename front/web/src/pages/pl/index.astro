---
/** Platform product landing in Polishpl. Only on a platform host; tenant sites have no language prefix. */
import Render from "@ulams/ui/Render.astro";
import Base from "../../layouts/Base.astro";
import { platformPage } from "../../lib/platform-page.ts";

if (!Astro.locals.platform) return Astro.rewrite("/404");
const page = await platformPage("pl", Astro.request, Astro.url);
if (!page) return Astro.rewrite("/404");
---

<Base theme="platform" title={page.meta.title} description={page.meta.description} lang={page.meta.lang} canonical={page.canonical} alternates={page.alternates} ogLocale={page.ogLocale}>
  <Render doc={page.doc} data={page.data} />
</Base>
