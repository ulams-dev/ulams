---
/** Localized public product comparison. */
import Render from "@ulams/ui/Render.astro";
import Base from "../../layouts/Base.astro";
import { comparisonPage } from "../../lib/platform-page.ts";

if (!Astro.locals.platform) return Astro.rewrite("/404");
const page = comparisonPage("pl", Astro.request, Astro.url);
if (!page) return Astro.rewrite("/404");
---

<Base theme="platform" title={page.meta.title} description={page.meta.description} lang={page.meta.lang} canonical={page.canonical} alternates={page.alternates} ogLocale={page.ogLocale} jsonLd={page.jsonLd}>
  <Render doc={page.doc} data={page.data} />
</Base>
