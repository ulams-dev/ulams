---
/** Reporting and analytics on the public product site (pl). */
import ImpactBody from "../../components/diagrams/ImpactBody.astro";
import Base from "../../layouts/Base.astro";
import { impactPage } from "../../lib/impact-pages.ts";

if (!Astro.locals.platform) return Astro.rewrite("/404");
const page = impactPage("reporting", "pl", Astro.request, Astro.url);
if (!page) return Astro.rewrite("/404");
---

<Base theme="platform" title={page.meta.title} description={page.meta.description} lang={page.meta.lang} canonical={page.canonical} alternates={page.alternates} ogLocale={page.ogLocale} jsonLd={page.jsonLd}>
  <ImpactBody doc={page.doc} data={page.data} page="reporting" locale="pl" />
</Base>
