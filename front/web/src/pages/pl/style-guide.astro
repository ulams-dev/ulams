---
/** The style guide and design system on the public product site (pl). */
import StyleGuideBody from "../../components/style-guide/StyleGuideBody.astro";
import Base from "../../layouts/Base.astro";
import { styleGuidePage } from "../../lib/style-guide.ts";

if (!Astro.locals.platform) return Astro.rewrite("/404");
const shell = styleGuidePage("pl", Astro.request, Astro.url);
if (!shell) return Astro.rewrite("/404");
---

<Base theme="platform" title={shell.meta.title} description={shell.meta.description} lang={shell.meta.lang} canonical={shell.canonical} alternates={shell.alternates} ogLocale={shell.ogLocale} jsonLd={shell.jsonLd}>
  <StyleGuideBody shell={shell} locale="pl" />
</Base>
