{
  "component": "Page",
  "props": {
    "theme": "nightsky",
    "title": "Night Sky Explorers — your adventure to the stars",
    "description": "Seven short missions through planets, stars and galaxies for kids aged 10–14, with Orbi the robot guide."
  },
  "children": [
    {
      "component": "SiteHeader",
      "props": {
        "brand": "Night Sky Explorers",
        "mark": "rocket",
        "links": [
          { "label": "Missions", "href": "#syllabus" },
          { "label": "Badges", "href": "#badges" },
          { "label": "For parents", "href": "#for-parents" },
          { "label": "For teachers", "href": "#for-teachers" },
          { "label": "Events", "href": "#events" }
        ],
        "signIn": { "label": "Log in", "href": "/login" },
        "cta": { "label": { "$data": "/course/landing/cta", "$default": "Start mission 1 — free" }, "href": { "$data": "/course/previewHref", "$default": "/" } }
      }
    },
    {
      "component": "Main",
      "children": [
        {
          "component": "Hero",
          "props": {
            "variant": "adventure",
            "eyebrow": "7 missions · free first mission",
            "title": { "$data": "/course/landing/headline", "$default": "Your adventure to the stars starts tonight" },
            "titleAccent": "starts tonight",
            "body": { "$data": "/course/summary" },
            "primaryCta": { "label": { "$data": "/course/landing/cta", "$default": "Start mission 1 — free" }, "href": { "$data": "/course/previewHref", "$default": "/" } },
            "secondaryCta": { "label": "See the mission map", "href": "#syllabus" },
            "illustration": "orbi",
            "caption": "Hi, I'm Orbi! Ready for lift-off?",
            "facts": { "$data": "/course/facts" }
          }
        },
        {
          "component": "Syllabus",
          "props": {
            "variant": "missions",
            "eyebrow": "Mission map",
            "title": "Seven missions to your own star map",
            "intro": "Short missions you can finish before bedtime: watch, play, listen and build.",
            "lessons": { "$data": "/course/lessons" },
            "totalLabel": { "$data": "/course/lessonsLabel" }
          }
        },
        {
          "component": "Badges",
          "props": {
            "eyebrow": "Rewards",
            "title": "Earn your astronomer badges",
            "intro": "Finish missions to collect badges on your way to Junior Astronomer.",
            "items": { "$data": "/course/badges" }
          }
        },
        {
          "component": "FormatGrid",
          "props": {
            "eyebrow": "Ways to explore",
            "title": "Every mission is different",
            "items": [
              { "format": "video", "tag": "Watch", "name": "Meet Orbi", "text": "Short animated films with read-along captions." },
              { "format": "interactive", "tag": "Play", "name": "Why does the Moon change?", "text": "Drag the Moon around Earth and watch the phases change." },
              { "format": "audio", "tag": "Listen", "name": "Sounds of space", "text": "Hear Saturn's rings turned into sound, with narration." },
              { "format": "scorm", "tag": "Game", "name": "Connect the stars", "text": "Draw constellations by joining the stars." },
              { "format": "tracked", "tag": "Challenge", "name": "Sky safari", "text": "A backyard challenge: check in what you saw tonight." },
              { "format": "project", "tag": "Make", "name": "Build your star map", "text": "Draw or photograph your own map and get a sticker back." }
            ]
          }
        },
        {
          "component": "FeatureList",
          "props": {
            "id": "for-parents",
            "variant": "checks",
            "eyebrow": "For parents",
            "title": "Made for curious kids, trusted by parents",
            "items": { "$data": "/course/lists/for_parents" }
          }
        },
        {
          "component": "FeatureList",
          "props": {
            "id": "for-teachers",
            "variant": "tiles",
            "eyebrow": "For teachers",
            "title": "Bring the cosmos to your classroom",
            "items": { "$data": "/course/lists/for_teachers" }
          }
        },
        {
          "component": "Quotes",
          "props": {
            "variant": "bubbles",
            "eyebrow": "Voices from the observation deck",
            "title": "What explorers say",
            "items": { "$data": "/course/testimonials" }
          }
        },
        {
          "component": "Events",
          "props": {
            "variant": "cards",
            "eyebrow": "Events",
            "title": "Star parties and live sessions",
            "items": { "$data": "/events" }
          }
        },
        {
          "component": "Pricing",
          "props": {
            "eyebrow": "Plans",
            "title": "For families and classrooms",
            "intro": "The first mission is free. In this demo every mission is open.",
            "plans": { "$data": "/plans" }
          }
        },
        {
          "component": "Faq",
          "props": {
            "eyebrow": "Questions",
            "title": "Questions from parents",
            "items": {
              "$data": "/course/faq",
              "$default": [
                { "q": "Do we need a telescope?", "a": "No. Every mission works with your eyes, a window or a balcony, and the screen." },
                { "q": "How long is a mission?", "a": "About ten to fifteen minutes, so one fits into an evening." },
                { "q": "Is the first mission free?", "a": "Yes. Mission 1, Lift-off, opens without paying." },
                { "q": "Is there Polish audio?", "a": "Yes, the course has English and Polish audio." }
              ]
            }
          }
        },
        {
          "component": "CtaBand",
          "props": {
            "variant": "banner",
            "eyebrow": "Ready?",
            "title": "Ready for lift-off?",
            "text": "Start mission 1 now. Orbi is waiting.",
            "cta": { "label": { "$data": "/course/landing/cta", "$default": "Start mission 1 — free" }, "href": { "$data": "/course/previewHref", "$default": "/" } }
          }
        }
      ]
    },
    {
      "component": "SiteFooter",
      "props": {
        "brand": "Night Sky Explorers",
        "text": "Exploring the cosmos one mission at a time.",
        "links": [
          { "label": "Missions", "href": "#syllabus" },
          { "label": "Badges", "href": "#badges" },
          { "label": "For parents", "href": "#for-parents" },
          { "label": "For teachers", "href": "#for-teachers" },
          { "label": "Events", "href": "#events" }
        ]
      }
    }
  ]
}
