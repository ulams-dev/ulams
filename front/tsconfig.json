{
  "compilerOptions": {
    "target": "es5",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "jsx": "react-jsx",

    /* Linting */
    "strict": true,

    "types": ["vite/client"],

    /* Path aliases (resolved by vite-tsconfig-paths in vite.config.mjs) */
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/utils/*": ["src/utils/*"],
      "@/config/*": ["src/config/*"],
      "@/types/*": ["src/types/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/icons/*": ["src/icons/*"],
      "@/pages/*": ["src/pages/*"],
      "@lms/components": ["src/lib/components/index.ts"],
      "@lms/components/*": ["src/lib/components/*"],
      "@lms/sdk": ["src/lib/sdk/index.ts"],
      "@lms/sdk/*": ["src/lib/sdk/*"],
      "@lms/scorm-player": ["src/lib/scorm-player/index.ts"],
      "@lms/scorm-player/*": ["src/lib/scorm-player/*"]
    }
  },
  "include": ["src"],

  "references": [{ "path": "./tsconfig.node.json" }]
}
