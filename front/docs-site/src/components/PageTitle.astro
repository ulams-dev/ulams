---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { Badge } from "@astrojs/starlight/components";

const data = Astro.locals.starlightRoute.entry.data;
const review = data.needsReview;
---

<Default />
{
  (data.coming || review || data.generatedFrom) && (
    <p class="ulams-title-badges">
      {data.coming && <Badge text="Coming" variant="caution" />}
      {review && <Badge text="Needs review" variant="danger" />}
      {data.generatedFrom && <Badge text={`Generated from ${data.generatedFrom}`} variant="note" />}
    </p>
  )
}
{typeof review === "string" && <p class="ulams-review-note">Needs review: {review}</p>}

<style>
  .ulams-title-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .ulams-review-note {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
