---
/** The posts of the blog section, newest first. A post is a page in src/content/docs/blog with a `date`. */
import { getCollection } from "astro:content";

const posts = (await getCollection("docs"))
  .filter((p) => p.id.startsWith("blog/") && p.id !== "blog" && p.id !== "blog/index" && p.data.date)
  .sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime());

const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<ul class="blog-list">
  {
    posts.map((p) => (
      <li>
        <time datetime={p.data.date!.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time>
        <a href={`/${p.id}/`}>{p.data.title}</a>
        <p>{p.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .blog-list {
    list-style: none;
    padding: 0;
  }
  .blog-list li {
    margin: 0 0 1.5rem;
    padding: 0 0 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .blog-list time {
    display: block;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .blog-list a {
    font-size: var(--sl-text-lg);
    font-weight: 600;
  }
  .blog-list p {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-2);
  }
</style>
