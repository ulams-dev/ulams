---
/**
 * A screenshot from src/assets/blog/<slug>/<name>.webp.
 *
 *   <BlogImage slug="living-course" name="review" alt="The source update review" caption="..." />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  slug: string;
  name: string;
  alt: string;
  caption?: string;
}

const { slug, name, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/blog/*/*.webp", { eager: true });
const image = images[`../assets/blog/${slug}/${name}.webp`]?.default;
if (!image) throw new Error(`BlogImage: src/assets/blog/${slug}/${name}.webp not found`);
const portrait = image.height > image.width;
---

<figure class:list={["blog-image", { portrait }]}>
  <Image src={image} alt={alt} widths={[480, 800, image.width]} sizes="(min-width: 72rem) 40rem, 100vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-image {
    margin: 1.5rem 0;
  }
  .blog-image img {
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  .blog-image.portrait img {
    max-width: 26rem;
    width: 100%;
    height: auto;
  }
  .blog-image figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }
</style>
