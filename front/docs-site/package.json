{
  "name": "@ulams/docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ulams documentation site: Astro Starlight, generated in part from the repository's ADRs, roadmap, package READMEs and UI catalogue.",
  "type": "module",
  "scripts": {
    "sync": "node --experimental-strip-types --no-warnings scripts/sync-content.mjs",
    "coverage": "node --experimental-strip-types --no-warnings scripts/coverage.mjs",
    "dev": "yarn sync && yarn api-browser && astro dev --port 4322",
    "build": "yarn sync && yarn coverage && yarn api-browser && astro build && yarn agent-files",
    "preview": "astro preview --port 4322",
    "typecheck": "yarn sync && astro check",
    "lint": "yarn sync && yarn coverage && yarn agent-files:check",
    "screenshots": "node scripts/screenshots.mjs",
    "agent-files": "node --experimental-strip-types --no-warnings scripts/agent-files.mjs",
    "agent-files:check": "node --experimental-strip-types --no-warnings scripts/agent-files.mjs --check",
    "api-browser": "node scripts/vendor-scalar.mjs && node --experimental-strip-types --no-warnings scripts/openapi.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@ulams/ui": "0.1.0",
    "astro": "7.4.0",
    "astro-mermaid": "2.1.0",
    "cookie": "2.0.1",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "mermaid": "11.17.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "axe-core": "^4.14.0",
    "jsdom": "^20.0.0",
    "starlight-links-validator": "0.27.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
