{
  "name": "ulams",
  "version": "0.1.0",
  "description": "Command line and MCP server for ulams instances: one command registry for humans and agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "ulams": "dist/ulams.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "ULAMS_E2E=1 vitest run tests/e2e",
    "sync-spec": "node scripts/sync-spec.mjs",
    "generate": "node scripts/gen-commands.mjs",
    "coverage": "node scripts/coverage.mjs",
    "eval": "node evals/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "ajv": "8.17.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.19.1",
    "@ulams/sdk": "0.1.0",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.4"
  }
}
