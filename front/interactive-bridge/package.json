{
  "name": "@ulams/interactive-bridge",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "The ulams-ix v1 postMessage bridge between a lesson page and an interactive package (ADR 0087). Zero dependencies.",
  "type": "module",
  "files": ["dist", "schema", "src", "LICENSE", "README.md"],
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./host": "./src/host.ts",
    "./package": "./src/package.ts",
    "./bundle": "./dist/interactive-bridge.js",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/bundle.mjs",
    "lint": "eslint src tests scripts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.4"
  }
}
