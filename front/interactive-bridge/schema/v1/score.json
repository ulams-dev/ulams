{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-ix/v1/score.json",
  "title": "score",
  "description": "Package to parent.",
  "type": "object",
  "required": [
    "ulams-ix",
    "type",
    "nonce",
    "raw",
    "max"
  ],
  "properties": {
    "ulams-ix": {
      "const": 1
    },
    "type": {
      "const": "score"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "raw": {
      "type": "number",
      "minimum": 0
    },
    "max": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "passed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
