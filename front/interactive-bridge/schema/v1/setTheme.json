{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-ix/v1/setTheme.json",
  "title": "setTheme",
  "description": "Parent to package.",
  "type": "object",
  "required": [
    "ulams-ix",
    "type",
    "nonce",
    "theme"
  ],
  "properties": {
    "ulams-ix": {
      "const": 1
    },
    "type": {
      "const": "setTheme"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "theme": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^--[a-z0-9-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "additionalProperties": false
}
