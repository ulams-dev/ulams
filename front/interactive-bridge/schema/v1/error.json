{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-ix/v1/error.json",
  "title": "error",
  "description": "Package to parent.",
  "type": "object",
  "required": [
    "ulams-ix",
    "type",
    "nonce",
    "code"
  ],
  "properties": {
    "ulams-ix": {
      "const": 1
    },
    "type": {
      "const": "error"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
