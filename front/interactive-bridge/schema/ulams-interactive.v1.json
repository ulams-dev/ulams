{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulams.dev/schemas/ulams-interactive/v1.json",
  "title": "ulams-interactive manifest v1",
  "description": "The manifest ulams-interactive.json at the root of an interactive package zip (ADR 0086).",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "licence",
    "locales",
    "defaultLocale",
    "bridge",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,40}$"
    },
    "title": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "default": "index.html"
    },
    "licence": {
      "type": "string",
      "maxLength": 64
    },
    "attribution": {
      "type": "string",
      "maxLength": 1000
    },
    "source": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        },
        "ref": {
          "type": "string",
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
      }
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
    },
    "bridge": {
      "const": 1
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "score": {
          "type": "boolean"
        },
        "background": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "enum": [
          "webgl"
        ]
      },
      "uniqueItems": true
    },
    "network": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 20,
            "propertyNames": {
              "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "text": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 20,
            "propertyNames": {
              "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "poster": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "a11y": {
      "type": "object",
      "properties": {
        "keyboard": {
          "type": "string",
          "maxLength": 1000
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
