---
import { renderMarkdown } from "../lib/markdown.ts";

interface Props {
  markdown: string;
  dropCap?: boolean;
  size?: "sm" | "md" | "lg";
}
const { markdown, dropCap = false, size = "md" } = Astro.props;
let html = renderMarkdown(markdown);
// The drop cap goes on the first real paragraph, not on an italic standfirst line.
if (dropCap) html = html.replace(/<p>(?!<em>[^<]*<\/em><\/p>)/, '<p class="u-dropcap">');
---

<div class:list={["u-prose", `u-prose--${size}`]} set:html={html} />

<style>
  .u-prose {
    max-width: 70ch;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .u-prose--sm {
    font-size: 0.9375rem;
  }
  .u-prose--lg {
    font-size: 1.1875rem;
  }
  .u-prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .u-prose :global(h1),
  .u-prose :global(h2),
  .u-prose :global(h3) {
    margin-top: 1.8em;
    line-height: 1.2;
  }
  .u-prose :global(h1) {
    font-size: 2rem;
  }
  .u-prose :global(h2) {
    font-size: 1.55rem;
  }
  .u-prose :global(h3) {
    font-size: 1.25rem;
  }
  .u-prose :global(p:first-child) {
    margin-top: 0;
  }
  .u-prose :global(.u-dropcap::first-letter) {
    float: left;
    margin: 0.1em 0.12em 0 0;
    font-family: var(--ulams-font-family);
    font-size: 4em;
    line-height: 0.82;
    color: var(--ulams-color-accent, var(--ulams-color-primary));
  }
  .u-prose :global(a) {
    color: var(--ulams-color-primary-on-light);
    text-underline-offset: 3px;
  }
  .u-prose :global(strong) {
    color: var(--ulams-color-header);
  }
  .u-prose :global(ul),
  .u-prose :global(ol) {
    padding-left: 1.4em;
  }
  .u-prose :global(li + li) {
    margin-top: 0.4em;
  }
  .u-prose :global(blockquote) {
    margin-inline: 0;
    padding: 0.6em 0 0.6em 1.2em;
    border-left: 3px solid var(--ulams-color-primary);
    font-family: var(--ulams-font-family);
    font-size: 1.1em;
    color: var(--ulams-color-header);
  }
  .u-prose :global(blockquote p + p) {
    margin-top: 0.6em;
  }
  .u-prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--ulams-color-card-bg);
    font-family: var(--ulams-font-mono);
    font-size: 0.88em;
  }
  .u-prose :global(pre) {
    overflow-x: auto;
    padding: 1em;
    border-radius: var(--ulams-radius);
    background: var(--ulams-color-card-bg);
    border: 1px solid var(--ulams-color-border);
  }
  .u-prose :global(pre code) {
    padding: 0;
    background: none;
  }
  .u-prose :global(.u-math) {
    overflow-x: auto;
    padding: 1em 1.2em;
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius);
    background: var(--ulams-color-card-bg);
    font-size: 1.15em;
  }
  .u-prose :global(math) {
    font-family: "STIX Two Math", "Cambria Math", "Latin Modern Math", math;
  }
  .u-prose :global(.u-table) {
    overflow-x: auto;
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius);
  }
  .u-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
    line-height: 1.5;
  }
  .u-prose :global(th),
  .u-prose :global(td) {
    padding: 0.7em 0.9em;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--ulams-color-border);
  }
  .u-prose :global(thead th) {
    background: var(--ulams-color-card-bg);
    font-weight: 600;
  }
  .u-prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .u-prose :global(tbody tr:hover) {
    background: color-mix(in srgb, var(--ulams-color-primary) 6%, transparent);
  }
  .u-prose :global(img) {
    border-radius: var(--ulams-radius);
  }
  .u-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--ulams-color-border);
    margin-block: 2em;
  }
</style>
