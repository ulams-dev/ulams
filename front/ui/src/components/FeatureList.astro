---
import Icon from "./Icon.astro";

interface Props {
  variant?: "tiles" | "checks" | "grid";
  eyebrow?: string;
  title?: string;
  intro?: string;
  items: Array<{ icon?: string; title: string; text?: string; status?: "available" | "coming" }>;
  cta?: { label: string; href: string };
  id?: string;
}
const { variant = "tiles", eyebrow, title, intro, items, cta, id } = Astro.props;
const anchor = id ?? (title ? title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") : undefined);
---

<section class={`u-section u-features u-features--${variant}`} id={anchor} aria-labelledby={title && anchor ? `${anchor}-title` : undefined}>
  <div class="u-container u-features__wrap">
    <div class="u-section-head" data-reveal>
      {eyebrow && <p class="u-eyebrow">{eyebrow}</p>}
      {title && <h2 class="u-h2" id={`${anchor}-title`}>{title}</h2>}
      {intro && <p class="u-lead">{intro}</p>}
      {
        cta && (
          <p>
            <a class="u-btn" href={cta.href}>
              {cta.label}
              <Icon name="arrow" />
            </a>
          </p>
        )
      }
    </div>
    <ul class="u-features__list" role="list">
      {
        items.map((item, i) => (
          <li class={variant === "checks" ? "" : "u-card u-card--hover"} data-reveal style={`--reveal-i:${i % 4}`}>
            <span class="u-features__icon">
              <Icon name={item.icon ?? "check"} />
            </span>
            <div>
              <h3>
                {item.title}
                {item.status === "coming" && <span class="u-status u-status--coming">Coming</span>}
              </h3>
              {item.text && <p>{item.text}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .u-features__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }
  .u-features__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
  }
  .u-features--tiles li {
    padding: 22px;
  }
  .u-features__list h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  /* grid: 3 columns, icon on top, glowing border on hover */
  .u-features--grid .u-features__list {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }
  .u-features--grid li {
    position: relative;
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 26px;
    overflow: hidden;
    isolation: isolate;
  }
  .u-features--grid li::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(400px 200px at var(--mx, 20%) -20%, color-mix(in srgb, var(--ulams-color-primary) 16%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.5s var(--ulams-ease);
  }
  .u-features--grid li:hover::before {
    opacity: 1;
  }
  .u-features--grid h3 {
    font-size: 1.2rem;
  }
  .u-features__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ulams-radius);
    background: color-mix(in srgb, var(--ulams-color-primary) 16%, transparent);
    color: var(--ulams-color-primary);
    transition: transform 0.5s var(--ulams-ease-bounce);
  }
  .u-features__list li:hover .u-features__icon {
    transform: scale(1.12) rotate(-6deg);
  }
  .u-features__list h3 {
    font-size: 1.1rem;
  }
  .u-features__list p {
    margin-top: 4px;
    font-size: 0.9rem;
    color: var(--ulams-color-muted);
  }
  .u-features--checks .u-features__wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .u-features--checks .u-features__list {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 860px) {
    .u-features--checks .u-features__wrap,
    .u-features--checks .u-features__list {
      grid-template-columns: 1fr;
    }
  }
</style>
