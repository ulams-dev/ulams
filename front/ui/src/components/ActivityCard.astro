---
import Icon from "./Icon.astro";

interface Props {
  kind?: "tracked" | "project" | "locked";
  title: string;
  text?: string;
  steps?: string[];
  cta?: { label: string; href: string };
}
const { kind = "tracked", title, text, steps = [], cta } = Astro.props;
const icon = kind === "project" ? "project" : kind === "locked" ? "lock" : "tracked";
---

<div class={`u-activity u-activity--${kind}`}>
  <span class="u-activity__icon"><Icon name={icon} /></span>
  <div class="u-activity__body">
    <h2>{title}</h2>
    {text && <p>{text}</p>}
    {
      steps.length > 0 && (
        <ol>
          {steps.map((s) => (
            <li>{s}</li>
          ))}
        </ol>
      )
    }
    {
      cta && (
        <a class="u-btn" href={cta.href}>
          {cta.label}
          <Icon name="arrow" />
        </a>
      )
    }
  </div>
</div>

<style>
  .u-activity {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    padding: clamp(22px, 4vw, 40px);
    border: 1px dashed var(--ulams-color-border);
    border-radius: var(--ulams-radius-card);
    background:
      radial-gradient(400px 200px at 0 0, color-mix(in srgb, var(--ulams-color-primary) 12%, transparent), transparent 70%),
      var(--ulams-color-card-bg);
  }
  .u-activity__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--ulams-color-primary);
    color: var(--ulams-color-on-primary);
  }
  .u-activity__icon :global(.u-icon) {
    width: 30px;
    height: 30px;
  }
  .u-activity--locked .u-activity__icon {
    background: var(--ulams-color-border);
    color: var(--ulams-color-text);
  }
  .u-activity__body {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .u-activity h2 {
    font-size: 1.5rem;
  }
  .u-activity p {
    color: var(--ulams-color-muted);
  }
  .u-activity ol {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }
  @media (max-width: 560px) {
    .u-activity {
      grid-template-columns: 1fr;
    }
  }
</style>
