---
import Icon from "./Icon.astro";

interface Props {
  text: string;
  tone?: "generated" | "assisted";
  id?: string;
}
const { text, tone = "generated", id } = Astro.props;
---

<p class={`u-ailabel u-ailabel--${tone}`} id={id}>
  <Icon name="sparkle" />
  <span>{text}</span>
</p>

<style>
  .u-ailabel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--ulams-color-border);
    background: var(--ulams-color-card-bg);
    color: var(--ulams-color-text);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .u-ailabel--assisted {
    border-style: dashed;
  }
  .u-ailabel :global(.u-icon) {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--ulams-color-primary-on-light);
  }
</style>
