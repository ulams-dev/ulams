---
import Icon from "./Icon.astro";

interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;

function embedUrl(raw: string): string | null {
  try {
    const u = new URL(raw);
    const host = u.hostname.replace(/^www\./, "");
    if (host === "youtube.com" || host === "m.youtube.com") {
      const id = u.searchParams.get("v");
      return id ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}` : null;
    }
    if (host === "youtu.be") return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(u.pathname.slice(1))}`;
    if (host === "vimeo.com") return `https://player.vimeo.com/video/${encodeURIComponent(u.pathname.split("/").filter(Boolean)[0] ?? "")}`;
    return null;
  } catch {
    return null;
  }
}
const src = embedUrl(url);
---

{
  src ? (
    <div class="u-embed">
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      />
    </div>
  ) : (
    <a class="u-embed__card u-card u-card--hover" href={url} target="_blank" rel="noopener noreferrer">
      <Icon name="embed" />
      <span>
        <strong>{title}</strong>
        <small>{url}</small>
      </span>
      <Icon name="external" />
    </a>
  )
}

<style>
  .u-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--ulams-radius-card);
    overflow: hidden;
    background: #000;
  }
  .u-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .u-embed__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 18px;
    text-decoration: none;
  }
  .u-embed__card span {
    display: grid;
  }
  .u-embed__card small {
    color: var(--ulams-color-muted);
    overflow-wrap: anywhere;
  }
</style>
