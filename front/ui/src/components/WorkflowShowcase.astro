---
import { uiStrings, pageLocale } from "../lib/i18n.ts";
/**
 * "Run your academy from anywhere": tabs of realistic windows (Claude Code, Claude chat with the
 * ulams MCP server, a plain shell, REST/SDK, the studio) whose commands, tool calls and answers are
 * typed line by line by the timeline player (elements/story.ts). The schedule is computed here, on the
 * server; the DOM holds the whole text from the start (no layout shift while typing), only the active
 * panel takes space (the stage height animates between tabs) and screen readers get a plain transcript. Tabs: roving tabindex,
 * aria-selected, aria-controls; they auto-advance slowly and stop on hover, focus, a manual choice or Pause.
 * Each tab may carry a status badge (the landing shows roadmap items honestly unless told otherwise).
 */
import StoryStyles from "./StoryStyles.astro";
import Icon from "./Icon.astro";

type Kind = "prompt" | "cmd" | "cont" | "agent" | "out" | "spin" | "tool" | "add" | "del" | "ctx" | "note" | "user" | "assistant" | "card";
interface Line {
  kind: Kind;
  text: string;
  args?: string;
  result?: string;
}
interface Tab {
  key: string;
  label: string;
  status?: "available" | "preview" | "coming";
  window: "terminal" | "chat" | "studio" | "admin";
  title: string;
  caption?: string;
  note?: string;
  lines: Line[];
}
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  valueLine?: string;
  description?: string;
  footnote?: string;
  legal?: string;
  /** Render a settled example instead of auto-typing it. Useful on product marketing pages. */
  staticPreview?: boolean;
  tabs: Tab[];
}
const { id = "agents", eyebrow, title, intro, valueLine, description, footnote, legal, staticPreview = false, tabs } = Astro.props;

const t = uiStrings(pageLocale(Astro));
const TAB_ICON: Record<string, string> = { admin: "menu", "claude-code": "code", "claude-mcp": "sparkle", cli: "terminal", api: "puzzle", studio: "layers" };
const STATUS = { available: t.available, preview: t.preview, coming: t.coming } as const;
const GLYPH: Partial<Record<Kind, string>> = { prompt: ">", cmd: "$", agent: "●", add: "+", del: "−", ctx: " ", out: " ", note: " ", cont: " " };
const SR: Record<Kind, string> = t.sr;

const RATE: Partial<Record<Kind, number>> = { prompt: 24, cmd: 26, cont: 20, user: 22, agent: 8, assistant: 9 };
const GAP: Partial<Record<Kind, number>> = { prompt: 500, cmd: 500, cont: 120, user: 600, agent: 350, assistant: 450, out: 220, tool: 450, spin: 250, card: 500 };

function schedule(lines: Line[]) {
  let t = 500;
  const rows = lines.map((line) => {
    t += GAP[line.kind] ?? 140;
    const rate = RATE[line.kind];
    const dur = rate ? Math.min(Math.round(line.text.length * rate), 2400) : 0;
    const row = { ...line, at: t, dur };
    t += dur;
    if (line.kind === "spin") t += 1000;
    if (line.kind === "tool" && line.result) t += 800;
    return row;
  });
  return { rows, total: t + 1500 };
}

const panels = tabs.map((tab, i) => ({ ...tab, ...schedule(tab.lines), i, tabId: `${id}-tab-${tab.key}`, panelId: `${id}-panel-${tab.key}` }));
---

<section class="u-section u-wf" id={id} aria-labelledby={title ? `${id}-title` : undefined}>
  <StoryStyles />
  <div class="u-container">
    <div class="u-section-head u-section-head--center" data-reveal>
      {eyebrow && <p class="u-eyebrow">{eyebrow}</p>}
      {title && <h2 class="u-h2" id={`${id}-title`}>{title}</h2>}
      {intro && <p class="u-lead">{intro}</p>}
    </div>
    <ulams-workflows dwell="3500">
      {description && <p class="u-visually-hidden">{description}</p>}
      <div class="u-wf__tabbar">
        <div class="u-wf__tabs" role="tablist" aria-label={t.waysToRun}>
          {
            panels.map((p) => (
              <button type="button" role="tab" id={p.tabId} aria-selected={p.i === 0 ? "true" : "false"} aria-controls={p.panelId} tabindex={p.i === 0 ? 0 : -1} class="u-wf__tab">
                <Icon name={TAB_ICON[p.key] ?? "code"} class="u-wf__tab-icon" />
                <span class="u-wf__tab-label">{p.label}</span>
                {p.status && p.status !== "available" && <span class="u-status u-status--coming">{STATUS[p.status]}</span>}
              </button>
            ))
          }
        </div>
        <button type="button" class="u-wf__pause" data-pause aria-label={t.pause} title={t.pause} aria-pressed="false" data-label-pause={t.pause} data-label-play={t.play}>
          <Icon name="pause" class="u-wf__pause-icon u-wf__pause-icon--pause" />
          <Icon name="play" class="u-wf__pause-icon u-wf__pause-icon--play" />
        </button>
      </div>
      <div class="u-stage u-wf__stage">
        <div class="u-wf__panels">
          {
            panels.map((p) => (
              <div class="u-wf__panel" role="tabpanel" id={p.panelId} aria-labelledby={p.tabId} tabindex="0" data-active={p.i === 0 ? "" : undefined}>
                <ulams-story data-total={p.total} data-hold="0" data-host-gated data-static={staticPreview ? "" : undefined}>
                  {p.window === "admin" ? (
                    <div class="u-win u-wf__win u-wf__win--admin" aria-hidden="true">
                      <div class="u-adm">
                        <aside class="u-adm__side">
                          <p class="u-adm__brand">{p.title}</p>
                          {p.rows.filter((row) => row.kind === "note").map((row, index) => (
                            <div class:list={["u-adm__nav", { "is-current": index === 0 }]} data-at={row.at}>{row.text}</div>
                          ))}
                        </aside>
                        <div class="u-adm__main">
                          <div class="u-adm__head">
                            <h3>{p.rows.find((row) => row.kind === "note")?.text}</h3>
                            <span class="u-adm__new">{t.adminNew}</span>
                          </div>
                          <table class="u-adm__table">
                            <thead>
                              <tr>
                                <th>{t.adminCourse}</th>
                                <th>{t.adminStatus}</th>
                                <th>{t.adminLearners}</th>
                              </tr>
                            </thead>
                            <tbody>
                              {p.rows.filter((row) => row.kind === "card").map((row) => {
                                const [status = "", learners = ""] = (row.args ?? "").split("|").map((part) => part.trim());
                                const draft = /draft|szkic|草稿/i.test(status);
                                return (
                                  <tr data-at={row.at}>
                                    <td>{row.text}</td>
                                    <td><span class:list={["u-adm__pill", { "is-draft": draft }]}>{status}</span></td>
                                    <td>{learners}</td>
                                  </tr>
                                );
                              })}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  ) : (
                  <div class={`u-win u-wf__win u-wf__win--${p.window}`} aria-hidden="true">
                    <div class="u-win__bar">
                      <span class="u-win__dots"><i></i><i></i><i></i></span>
                      <span>{p.title}</span>
                    </div>
                    <div class="u-win__body u-wf__body">
                      {p.rows.map((row) => {
                        const typed = row.dur > 0;
                        if (row.kind === "tool") {
                          return (
                            <div class="u-wf__ln u-wf__tool" data-at={row.at}>
                              <span class="u-wf__chip">
                                <span class="u-wf__caret">▸</span>
                                <b>{row.text}</b>
                                {row.args && <span class="u-wf__args">{row.args}</span>}
                                {row.result && <span class="u-wf__res" data-at={row.at + 800}>→ {row.result}</span>}
                              </span>
                            </div>
                          );
                        }
                        if (row.kind === "user" || row.kind === "assistant") {
                          return (
                            <div class={`u-wf__ln u-wf__bubble u-wf__bubble--${row.kind}`} data-at={row.at}>
                              <span data-at={row.at} data-type={row.dur}>{row.text}</span>
                            </div>
                          );
                        }
                        if (row.kind === "card") {
                          return (
                            <div class="u-wf__ln u-wf__card" data-at={row.at}>
                              <p>{row.text}</p>
                              {row.args && <span class="u-wf__actions">{row.args.split("|").map((a, k) => <span class={k === 0 ? "is-primary" : ""}>{a.trim()}</span>)}</span>}
                            </div>
                          );
                        }
                        if (row.kind === "spin") {
                          return (
                            <div class="u-wf__ln u-wf__row" data-kind="spin" data-at={row.at}>
                              <span class="u-wf__g">
                                <i class="u-wf__spinner" data-at={row.at} data-until={row.at + 1000}></i>
                                <b class="u-wf__ok" data-at={row.at + 1000}>✓</b>
                              </span>
                              <span>{row.text}</span>
                            </div>
                          );
                        }
                        return (
                          <div class="u-wf__ln u-wf__row" data-kind={row.kind} data-at={row.at}>
                            <span class="u-wf__g">{GLYPH[row.kind] ?? " "}</span>
                            {typed ? <span data-at={row.at} data-type={row.dur}>{row.text}</span> : <span>{row.text}</span>}
                          </div>
                        );
                      })}
                    </div>
                  </div>
                  )}
                  <ul class="u-visually-hidden">
                    {p.window === "admin" ? p.lines.map((l) => (
                      <li>
                        {l.kind === "note" ? `${t.adminSection}: ${l.text}` : `${t.adminCourse}: ${l.text}. ${l.args ?? ""}`}
                      </li>
                    )) : p.lines.map((l) => (
                      <li>
                        {SR[l.kind]}: {l.text}
                        {l.args ? ` ${l.args}` : ""}
                        {l.result ? ` ${t.returned} ${l.result}` : ""}
                      </li>
                    ))}
                  </ul>
                </ulams-story>
                {p.caption && <p class="u-wf__cap">{p.caption}</p>}
                {p.note && <p class="u-wf__note">{p.note}</p>}
              </div>
            ))
          }
        </div>
      </div>
    </ulams-workflows>
    {valueLine && <p class="u-wf__value">{valueLine}</p>}
    {footnote && <p class="u-wf__foot">{footnote}</p>}
    {legal && <p class="u-wf__foot">{legal}</p>}
  </div>
</section>

<style is:global>
  .u-wf__tabbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .u-wf__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .u-wf__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--ulams-color-border);
    background: var(--ulams-color-card-bg);
    color: var(--ulams-color-text);
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .u-wf__tab:hover {
    border-color: var(--ulams-brand-indigo);
  }
  .u-wf__tab[aria-selected="true"] {
    background: var(--ulams-brand-indigo);
    border-color: var(--ulams-brand-indigo);
    color: #fff;
  }
  .u-wf__tab[aria-selected="true"] .u-status {
    color: #fff;
  }
  .u-wf__tab[aria-selected="true"] .u-status--available {
    background: color-mix(in srgb, #fff 18%, transparent);
  }
  .u-wf__tab:focus-visible {
    outline: 3px solid var(--ulams-brand-blue);
    outline-offset: 2px;
  }
  .u-wf__pause {
    color: var(--ulams-color-text);
  }
  .u-wf__panels {
    position: relative;
  }
  .u-wf__panels[data-resizing] {
    overflow: hidden;
    transition: height 0.35s var(--ulams-ease);
  }
  .u-wf__panel {
    min-width: 0;
  }
  .u-wf__panel:not([data-active]) {
    position: absolute;
    inset: 0 0 auto;
    visibility: hidden;
  }
  .u-wf__panel:focus-visible {
    outline: 3px solid var(--ulams-brand-sky);
    outline-offset: 4px;
    border-radius: 12px;
  }
  .u-wf__body {
    display: grid;
    gap: 3px;
    align-content: start;
    min-height: 100%;
  }
  .u-wf__row {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    gap: 1ch;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .u-wf__g {
    position: relative;
    color: var(--ulams-brand-orange);
    user-select: none;
  }
  .u-wf__row[data-kind="out"],
  .u-wf__row[data-kind="note"] {
    color: var(--st-dim);
  }
  .u-wf__row[data-kind="agent"] {
    color: var(--st-text);
    margin-top: 6px;
  }
  .u-wf__row[data-kind="prompt"],
  .u-wf__row[data-kind="cmd"] {
    margin-top: 8px;
    color: #fff;
  }
  .u-wf__row[data-kind="add"] {
    color: var(--st-ok);
    background: color-mix(in srgb, var(--st-ok) 10%, transparent);
  }
  .u-wf__row[data-kind="del"] {
    color: var(--st-bad);
    background: color-mix(in srgb, var(--st-bad) 10%, transparent);
  }
  .u-wf__row[data-kind="add"] .u-wf__g,
  .u-wf__row[data-kind="del"] .u-wf__g {
    color: inherit;
  }
  .u-wf__row[data-kind="spin"] {
    color: var(--st-dim);
  }
  .u-wf__spinner {
    position: absolute;
    top: 0.45em;
    left: 0.1ch;
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--ulams-brand-orange) 30%, transparent);
    border-top-color: var(--ulams-brand-orange);
    animation: u-spin 0.8s linear infinite;
  }
  .u-wf__ok {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--st-ok);
  }
  .u-wf__tool {
    margin: 4px 0;
  }
  .u-wf__chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    max-width: 100%;
    padding: 3px 10px;
    border-radius: 8px;
    border: 1px dashed color-mix(in srgb, var(--ulams-brand-sky) 60%, transparent);
    background: color-mix(in srgb, var(--ulams-brand-sky) 9%, transparent);
    color: var(--ulams-brand-sky);
    overflow-wrap: anywhere;
  }
  .u-wf__chip b {
    font-weight: 600;
  }
  .u-wf__caret {
    color: var(--ulams-brand-orange);
  }
  .u-wf__args {
    color: var(--st-dim);
  }
  .u-wf__res {
    color: var(--st-ok);
  }

  /* chat and studio windows are light */
  .u-wf__win--chat,
  .u-wf__win--studio {
    --st-text: #18181b;
    --st-dim: #52525b;
    --st-line: #e7e5e4;
    background: #fff;
    color: #18181b;
    font-family: var(--ulams-font-family-body, system-ui, sans-serif);
    font-size: 0.9375rem;
  }
  .u-wf__win--chat .u-win__bar,
  .u-wf__win--studio .u-win__bar {
    background: #f4f4f3;
    color: #52525b;
    font-family: var(--ulams-font-mono);
  }
  .u-wf__win--chat .u-win__dots i,
  .u-wf__win--studio .u-win__dots i {
    background: #d6d3d1;
  }
  .u-wf__win--chat .u-wf__body,
  .u-wf__win--studio .u-wf__body {
    gap: 10px;
    padding: 18px;
  }
  .u-wf__bubble {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 14px;
    line-height: 1.55;
  }
  .u-wf__bubble--user {
    justify-self: end;
    background: var(--ulams-brand-indigo);
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .u-wf__bubble--assistant {
    justify-self: start;
    background: #f4f4f3;
    border-bottom-left-radius: 4px;
  }
  .u-wf__win--chat .u-wf__chip,
  .u-wf__win--studio .u-wf__chip {
    color: var(--ulams-brand-blue);
    border-color: color-mix(in srgb, var(--ulams-brand-blue) 55%, transparent);
    background: color-mix(in srgb, var(--ulams-brand-blue) 7%, transparent);
    font-family: var(--ulams-font-mono);
    font-size: 0.8125rem;
  }
  .u-wf__win--chat .u-wf__args {
    color: #52525b;
  }
  .u-wf__win--chat .u-wf__res {
    color: #15803d;
  }
  .u-wf__card {
    border: 1px solid var(--ulams-color-border, #e7e5e4);
    border-radius: 12px;
    padding: 12px 14px;
    background: #fafaf9;
    display: grid;
    gap: 10px;
  }
  .u-wf__card p {
    margin: 0;
  }
  .u-wf__actions {
    display: flex;
    gap: 8px;
  }
  .u-wf__actions span {
    padding: 4px 14px;
    border-radius: 8px;
    border: 1px solid #d6d3d1;
    font-weight: 600;
    font-size: 0.8125rem;
  }
  .u-wf__actions .is-primary {
    background: var(--ulams-brand-indigo);
    border-color: var(--ulams-brand-indigo);
    color: #fff;
  }
  .u-wf__win--chat .u-cur,
  .u-wf__win--studio .u-cur {
    background: var(--ulams-brand-indigo);
  }
  .u-wf__win--chat .u-wf__bubble--user .u-cur {
    background: #fff;
  }
  .u-wf__cap {
    margin: 14px 4px 0;
    color: var(--st-dim, #a9bed3);
    font-size: 0.9375rem;
  }
  .u-wf__stage .u-wf__cap {
    color: #c9d8e8;
  }
  .u-wf__note {
    margin: 6px 4px 0;
    font-size: 0.8125rem;
    color: #a9bed3;
    font-style: italic;
  }
  .u-wf__value {
    margin: 22px auto 0;
    max-width: 62ch;
    text-align: center;
    font-size: 1.125rem;
    color: var(--ulams-color-muted);
  }
  .u-wf__foot {
    margin: 12px auto 0;
    max-width: 70ch;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ulams-color-muted);
  }
  .u-wf__win--admin {
    background: #fff;
    color: #18181b;
    font-family: var(--ulams-font-family-body, system-ui, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.4;
    border: 0;
  }
  .u-adm {
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    min-height: 280px;
  }
  .u-adm__side {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 16px 10px;
    background: var(--ulams-brand-indigo);
    color: #eaf1f8;
  }
  .u-adm__brand {
    margin: 0 8px 12px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .u-adm__nav {
    padding: 8px 10px;
    border-radius: 8px;
    color: #c9d8e8;
  }
  .u-adm__nav.is-current {
    background: color-mix(in srgb, #fff 16%, transparent);
    color: #fff;
    font-weight: 700;
  }
  .u-adm__main {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 16px;
    background: #f4f6f8;
  }
  .u-adm__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .u-adm__head h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .u-adm__new {
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--ulams-brand-orange);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .u-adm__table {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border: 1px solid #e7e5e4;
    border-radius: 10px;
    background: #fff;
  }
  .u-adm__table th {
    padding: 8px 12px;
    border-bottom: 1px solid #e7e5e4;
    color: #71717a;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
  }
  .u-adm__table td {
    padding: 10px 12px;
    border-bottom: 1px solid #f4f4f3;
  }
  .u-adm__table tr:last-child td {
    border-bottom: 0;
  }
  .u-adm__pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: #e8f8ef;
    color: #166534;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .u-adm__pill.is-draft {
    background: #f4f4f3;
    color: #52525b;
  }
  @media (max-width: 640px) {
    .u-wf__win {
      font-size: 0.75rem;
    }
    .u-wf__tab {
      font-size: 0.8125rem;
      padding: 6px 10px;
    }
    .u-adm {
      grid-template-columns: 108px minmax(0, 1fr);
      min-height: 240px;
    }
    .u-adm__main,
    .u-adm__side {
      padding: 10px;
    }
    .u-adm__table th,
    .u-adm__table td {
      padding: 8px;
    }
  }
</style>
