---
import Icon from "./Icon.astro";
import { renderMarkdown } from "../lib/markdown.ts";

interface Props {
  quizId: number;
  title: string;
  intro?: string;
  maxAttempts?: number;
  minutes?: number;
  passScore?: number;
  courseId?: number;
  topicId?: number;
  finishHref?: string;
}
const { quizId, title, intro, maxAttempts = 0, minutes = 0, passScore = 0, finishHref } = Astro.props;
---

<ulams-quiz class="u-quiz" quiz-id={quizId} pass-score={passScore} finish-href={finishHref}>
  <div class="u-quiz__top">
    <p class="u-quiz__title"><Icon name="quiz" /> {title}</p>
    <p class="u-quiz__clock" data-clock hidden aria-label="Time left"></p>
  </div>
  <div class="u-quiz__stage" data-stage>
    {intro && <div class="u-quiz__intro" set:html={renderMarkdown(intro)} />}
    <ul class="u-quiz__facts" role="list">
      {minutes > 0 && <li><Icon name="clock" /> {minutes} minutes</li>}
      {maxAttempts > 0 && <li><Icon name="check" /> {maxAttempts} attempts</li>}
      {passScore > 0 && <li><Icon name="medal" /> {passScore} points to pass</li>}
    </ul>
    <button class="u-btn" type="button" data-start>
      Start the quiz
      <Icon name="arrow" />
    </button>
  </div>
  <p class="u-visually-hidden" aria-live="polite" data-live></p>
</ulams-quiz>

<script>
  import "../elements/quiz.ts";
</script>

<style>
  .u-quiz {
    display: block;
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius-card);
    background: var(--ulams-color-card-bg);
    overflow: hidden;
  }
  .u-quiz__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--ulams-color-border);
  }
  .u-quiz__title {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-weight: 700;
  }
  .u-quiz__clock {
    font-family: var(--ulams-font-mono);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--ulams-radius);
    background: var(--ulams-color-bg);
  }
  .u-quiz__clock[data-low] {
    color: var(--ulams-color-error);
    animation: u-blink-soft 1s infinite;
  }
  @keyframes u-blink-soft {
    50% {
      opacity: 0.5;
    }
  }
  .u-quiz__stage {
    display: grid;
    gap: 22px;
    padding: clamp(20px, 4vw, 40px);
    min-height: 360px;
    align-content: start;
  }
  .u-quiz__stage :global(> *) {
    animation: u-quiz-in 0.35s var(--ulams-ease) both;
  }
  @keyframes u-quiz-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }
  .u-quiz__intro {
    font-size: 1.0625rem;
    max-width: 62ch;
  }
  .u-quiz__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    color: var(--ulams-color-muted);
  }
  .u-quiz__facts li {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .u-quiz__stage > .u-btn {
    justify-self: start;
  }
  .u-quiz :global(.u-quiz__skeleton) {
    display: grid;
    gap: 14px;
  }
  .u-quiz :global(.u-quiz__progress) {
    display: grid;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--ulams-color-muted);
  }
  .u-quiz :global(.u-quiz__bar) {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--ulams-color-primary) var(--p), var(--ulams-color-border) var(--p));
    transition: background 0.4s;
  }
  .u-quiz :global(.u-quiz__dots) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .u-quiz :global(.u-quiz__dots button) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--ulams-color-border);
    background: var(--ulams-color-bg);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .u-quiz :global(.u-quiz__dots button[data-answered]) {
    border-color: var(--ulams-color-positive);
  }
  .u-quiz :global(.u-quiz__dots button[aria-current]) {
    background: var(--ulams-color-primary);
    border-color: var(--ulams-color-primary);
    color: var(--ulams-color-on-primary);
  }
  .u-quiz :global(.u-quiz__q) {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .u-quiz :global(legend) {
    padding: 0;
    font-family: var(--ulams-font-family);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.3;
    color: var(--ulams-color-header);
  }
  .u-quiz :global(legend:focus) {
    outline: none;
  }
  .u-quiz :global(.u-quiz__hint) {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--ulams-color-muted);
  }
  .u-quiz :global(.u-quiz__options) {
    display: grid;
    gap: 10px;
  }
  .u-quiz :global(.u-quiz__options--tf) {
    grid-template-columns: 1fr 1fr;
  }
  .u-quiz :global(.u-quiz__option) {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 54px;
    padding: 12px 16px;
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius);
    background: var(--ulams-color-bg);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s var(--ulams-ease), background-color 0.2s;
  }
  .u-quiz :global(.u-quiz__option:hover) {
    border-color: var(--ulams-color-primary);
    transform: translateX(3px);
  }
  .u-quiz :global(.u-quiz__option:has(input:checked)) {
    border-color: var(--ulams-color-primary);
    background: color-mix(in srgb, var(--ulams-color-primary) 10%, var(--ulams-color-bg));
  }
  .u-quiz :global(.u-quiz__option input) {
    width: 20px;
    height: 20px;
    accent-color: var(--ulams-color-primary);
  }
  .u-quiz :global(.u-quiz__field) {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius-input);
    background: var(--ulams-color-input-bg, var(--ulams-color-bg));
  }
  .u-quiz :global(.u-quiz__field--num) {
    max-width: 220px;
    font-family: var(--ulams-font-mono);
    font-size: 1.2rem;
  }
  .u-quiz :global(.u-quiz__count) {
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--ulams-color-muted);
  }
  .u-quiz :global(.u-quiz__matching) {
    display: grid;
    gap: 10px;
  }
  .u-quiz :global(.u-quiz__pair) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }
  .u-quiz :global(.u-quiz__pair label) {
    font-weight: 600;
  }
  .u-quiz :global(.u-quiz__nav) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .u-quiz :global(.u-quiz__nav .u-btn[disabled]) {
    opacity: 0.45;
    pointer-events: none;
  }
  .u-quiz :global(.u-quiz__scoring) {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 48px 0;
  }
  .u-quiz :global(.u-quiz__spinner) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 4px solid var(--ulams-color-border);
    border-top-color: var(--ulams-color-primary);
    animation: u-spin360 0.8s linear infinite;
  }
  @keyframes u-spin360 {
    to {
      transform: rotate(360deg);
    }
  }
  .u-quiz :global(.u-quiz__result) {
    display: grid;
    gap: 16px;
    justify-items: center;
    text-align: center;
  }
  .u-quiz :global(.u-quiz__result h3) {
    font-size: 1.8rem;
  }
  .u-quiz :global(.u-quiz__ring) {
    --c: var(--ulams-color-positive);
    display: grid;
    place-items: center;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--ulams-color-card-bg) 78%, transparent 80%),
      conic-gradient(var(--c) calc(var(--p) * 1%), var(--ulams-color-border) 0);
    animation: u-ring 1.2s var(--ulams-ease) both;
  }
  .u-quiz :global([data-passed="false"] .u-quiz__ring) {
    --c: var(--ulams-color-warn);
  }
  @property --p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @keyframes u-ring {
    from {
      --p: 0;
    }
  }
  .u-quiz :global(.u-quiz__ring strong) {
    font-family: var(--ulams-font-family);
    font-size: 2rem;
  }
  .u-quiz :global(.u-quiz__review) {
    list-style: none;
    margin: 8px 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 8px;
    text-align: left;
  }
  .u-quiz :global(.u-quiz__review li) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    padding: 12px 14px;
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius);
    background: var(--ulams-color-bg);
  }
  .u-quiz :global(.u-quiz__review small) {
    display: block;
    color: var(--ulams-color-muted);
  }
  .u-quiz :global(.u-quiz__review em) {
    grid-column: 2;
    font-size: 0.875rem;
  }
  .u-quiz :global(.u-quiz__mark) {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-weight: 700;
    background: var(--ulams-color-border);
  }
  .u-quiz :global([data-result="ok"] .u-quiz__mark) {
    background: var(--ulams-color-positive);
    color: var(--ulams-color-bg);
  }
  .u-quiz :global([data-result="miss"] .u-quiz__mark) {
    background: var(--ulams-color-error);
    color: var(--ulams-color-bg);
  }
  .u-quiz :global(.u-quiz__error) {
    color: var(--ulams-color-error);
    font-weight: 600;
  }
  @media (max-width: 520px) {
    .u-quiz :global(.u-quiz__pair) {
      grid-template-columns: 1fr;
    }
  }
</style>
