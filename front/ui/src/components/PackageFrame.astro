---
import Icon from "./Icon.astro";

interface Props {
  src: string;
  title: string;
  height?: number;
  /** Player on the tenant content origin: sandboxed, and the URL (with its token) is not shown. */
  isolated?: boolean;
}
const { src, title, height = 640, isolated = false } = Astro.props;
---

<div class="u-package">
  <div class="u-package__bar">
    <span><Icon name="scorm" /> {title}</span>
    {!isolated && <a class="u-btn u-btn--ghost u-btn--sm" href={src} target="_blank" rel="noopener"><Icon name="external" /> Full screen</a>}
  </div>
  <div class="u-package__stage" style={`--h:${height}px`}>
    <div class="u-package__loading u-skeleton" aria-hidden="true"></div>
    {isolated ? (
      <iframe src={src} title={title} allow="fullscreen; autoplay" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads"></iframe>
    ) : (
      <iframe src={src} title={title} loading="lazy" allow="fullscreen"></iframe>
    )}
  </div>
</div>

<style>
  .u-package {
    border: 1px solid var(--ulams-color-border);
    border-radius: var(--ulams-radius-card);
    overflow: hidden;
    background: var(--ulams-color-card-bg);
  }
  .u-package__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--ulams-color-border);
  }
  .u-package__bar > span {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-weight: 600;
  }
  .u-package__stage {
    position: relative;
    height: min(var(--h), 80vh);
    background: #fff;
  }
  .u-package__loading {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .u-package iframe {
    position: relative;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
