    animation: ps-paper-enter 0.65s 0.5s ease both;
  }
  .ps-proposal {
    animation: ps-enter 0.5s 0.55s ease both;
  }
  .ps-added {
    animation: ps-enter 0.5s 0.2s ease both;
  }
  .ps-notification {
    animation: ps-enter 0.5s 0.1s ease both;
