  .ps-bottom {
    --ps-mark: 36px;
    --ps-tray: color-mix(in srgb, var(--ulams-color-primary) 4%, var(--ulams-color-surface));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 12px;
    align-items: start;
    margin: 0 16px 16px;
    padding: 14px 16px;
    background: var(--ps-tray);
    border: 1px solid var(--ulams-color-border);
    border-radius: 18px;
  }
  .ps-navigation {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    align-items: start;
  }
  .ps-navigation::before {
    content: "";
    position: absolute;
    top: calc((var(--ps-mark) - 2px) / 2);
    right: calc(100% / 14);
    left: calc(100% / 14);
    height: 2px;
    background: color-mix(in srgb, var(--ulams-color-primary) 18%, var(--ulams-color-border));
    border-radius: 99px;
  }
  .ps-navigation button {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    min-width: 0;
    padding: 0;
    color: var(--ulams-color-muted);
    font: 650 0.68rem/1.15 var(--ulams-font-family-body);
    text-align: center;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .ps-step-mark {
    display: grid;
    width: var(--ps-mark);
    height: var(--ps-mark);
    place-items: center;
    color: var(--ulams-color-muted);
    background: var(--ulams-color-card-bg);
    border: 1.5px solid var(--ulams-color-border);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--ps-tray);
    transition: background 0.25s var(--ulams-ease), color 0.25s var(--ulams-ease), border-color 0.25s var(--ulams-ease);
  }
  .ps-navigation :global(svg) {
    width: 15px;
    height: 15px;
  }
  .ps-navigation button > span:last-of-type {
    max-width: 100%;
  }
  .ps-dwell {
    display: block;
    width: 28px;
    height: 3px;
    overflow: hidden;
    border-radius: 99px;
    background: color-mix(in srgb, var(--ulams-color-primary) 14%, var(--ulams-color-border));
  }
  .ps-dwell b {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ulams-brand-orange);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .ps-dwell.is-running b {
    animation: ps-dwell linear var(--ps-dwell, 6s) forwards;
  }
  .ps-navigation button:has(~ button[aria-selected="true"]) .ps-dwell b {
    transform: scaleX(1);
  }
  @keyframes ps-dwell {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .ps-navigation button:hover .ps-step-mark {
    color: var(--ulams-color-primary);
    border-color: var(--ulams-color-primary);
  }
  .ps-navigation button:has(~ button[aria-selected="true"]) {
    color: var(--ulams-color-primary);
  }
  .ps-navigation button:has(~ button[aria-selected="true"]) .ps-step-mark {
    color: var(--ulams-color-primary);
    background: color-mix(in srgb, var(--ulams-color-primary) 10%, var(--ulams-color-card-bg));
    border-color: color-mix(in srgb, var(--ulams-color-primary) 40%, var(--ulams-color-border));
  }
  .ps-navigation button[aria-selected="true"] {
    color: var(--ulams-color-primary);
  }
  .ps-navigation button[aria-selected="true"] .ps-step-mark {
    color: #fff;
    background: var(--ulams-color-primary);
    border-color: var(--ulams-color-primary);
  }
  .ps-controls {
    display: flex;
    gap: 4px;
    align-items: center;
    align-self: stretch;
    padding-left: 12px;
    border-left: 1px solid var(--ulams-color-border);
