---
import Icon from "./Icon.astro";
import RolePortrait from "./RolePortrait.astro";
import { pageLocale, uiStrings } from "../lib/i18n.ts";
export interface PolicyStoryProps {
  ariaLabel?: string;
  badge?: string;
  title?: string;
  note?: string;
  journey: Array<{
    title: string;
    text: string;
    bullets?: string[];
    status?: "available" | "coming";
  }>;
  visual: {
    chapters: string[];
    intake: {
      uploader: string;
      upload: string;
      uploaded: string;
      styleguide: string;
      extract: string;
      context: string;
      llm: string;
      sourceReady: string;
      briefTitle: string;
      ready: string;
      questions: Array<{ question: string; answer: string }>;
    };
    policy: string;
    section: string;
    before: string;
    after: string;
    audiences: string[];
    roleTopics: string[];
    learners: string[];
    academy: string;
    lesson: string;
    formats: string[];
    exam: string;
    certificate: string;
    completed: string;
    pending: string;
    owner: string;
    progress: string;
    later: string;
    proposal: string;
    approval: string;
    renewal: string;
    expired: string;
    minor: string;
    major: string;
    notification: string;
    renewed: string;
  };
}
const {
  ariaLabel,
  badge,
  journey,
  visual: v,
  note,
} = Astro.props as PolicyStoryProps;
const t = uiStrings(pageLocale(Astro));
const icons = ["pdf", "chat", "layers", "book", "chart", "sync", "medal"];
const domains = ["management.example.test", "hr.example.test", "sales.example.test"];
const roles = ["management", "hr", "sales"] as const;
const alternatives = [
  `${v.intake.uploader}: ${v.intake.upload}, ${v.intake.styleguide}. ${v.intake.extract} → ${v.intake.context} → ${v.intake.llm}. ${v.section}: ${v.before}`,
  v.intake.questions.map(({ question, answer }) => `${question} ${answer}`).join(" "),
  v.audiences.map((role, i) => `${role}: ${v.roleTopics[i]}. ${domains[i]}`).join(". "),
  `${v.academy}. ${v.formats.join(" → ")} → ${v.certificate} PDF v1.`,
  v.learners.map((learner, i) => `${learner}: ${i < 2 ? v.completed : v.pending}`).join(". "),
  `${v.later}. ${v.section}: ${v.before} → ${v.after}. ${v.lesson}, ${v.exam}. ${v.approval}.`,
  `${v.notification} ${v.expired}. ${v.minor}. ${v.major}. ${v.renewed} PDF v2.`,
];
---
<figure class="policy-story" id="living-course" aria-label={ariaLabel}>
  <ulams-policy-story data-animation-paused>
    <div class="ps-topline"><span>{badge}</span><span class="ps-version">v1 <Icon name="arrow" /> v2</span></div>
    <div class="ps-scenes">
      {journey.map((step, i) => <section class="ps-panel" role="tabpanel" id={`policy-panel-${i}`} aria-labelledby={`policy-tab-${i}`} hidden={i !== 0} tabindex="0" data-duration={i === 0 ? 10500 : i === 1 ? 15000 : 6000}>
        <div class="ps-narration">
          <span class="ps-chapter">0{i + 1} / 0{journey.length}</span>
          <h2>{step.title}</h2><p>{step.text}</p>
          {step.bullets && <ul class="ps-explanation" role="list">{step.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          <p class="u-visually-hidden">{alternatives[i]}</p>
        </div>
        <div class={`ps-scene ps-scene--${i}`} aria-hidden="true">
          {i === 0 && <div class="ps-intake-scene">
            <div class="ps-upload-panel">
              <span class="ps-upload-actor"><span class="ps-upload-face"><RolePortrait role="ceo" /></span><b>{v.intake.uploader}</b><span>{v.intake.upload}</span></span>
              <div class="ps-upload-files"><div class="ps-upload-file"><Icon name="pdf" /><div><b>privacy-policy.pdf</b><small>{v.policy} · v1</small><span class="ps-upload-track"><i /></span></div><span class="ps-upload-done"><Icon name="check" /></span></div><div class="ps-upload-file ps-upload-file--styleguide"><Icon name="layers" /><div><b>styleguide.pdf</b><small>{v.intake.styleguide}</small><span class="ps-brand-swatches"><i /><i /><i /></span></div><span class="ps-style-done"><Icon name="check" /></span></div></div>
            </div>
            <div class="ps-ingest-pipeline">
              <div class="ps-ingest-node ps-ingest-node--extract"><span class="ps-ingest-icon"><Icon name="reading" /></span><div><b>{v.intake.extract}</b><span class="ps-extracted-lines"><i /><i /><i /></span></div><Icon name="check" /></div>
              <div class="ps-ingest-node ps-ingest-node--context"><span class="ps-ingest-icon"><Icon name="layers" /></span><div><b>{v.intake.context}</b><span class="ps-source-fragments"><i>§ 1</i><i>§ 2</i><i>§ 4</i><Icon name="quote" /></span></div><Icon name="check" /></div>
              <div class="ps-ingest-node ps-ingest-node--llm"><span class="ps-ingest-icon"><Icon name="sparkle" /></span><div><b>{v.intake.llm}</b><span class="ps-small">{v.intake.sourceReady}</span></div><Icon name="check" /></div>
            </div>
            <div class="ps-ingest-quote"><Icon name="quote" /><span><b>{v.section}</b>{v.before}</span></div>
          </div>}
          {i === 1 && <div class="ps-brief-scene">
            <div class="ps-brief-bar"><Icon name="sparkle" /><b>{v.intake.briefTitle}</b><span class="ps-brief-source"><Icon name="quote" /> PDF · v1</span></div>
            <div class="ps-brief-chat"><div class="ps-brief-chat-log">{v.intake.questions.map((pair, n) => <div class="ps-brief-pair" style={`--pair:${n}`}>
              <div class="ps-chat-message ps-chat-message--question"><div class="ps-chat-message-inner"><p class="ps-brief-question"><span class="ps-chat-agent"><Icon name="sparkle" /></span><span class="ps-chat-bubble"><small>ULAMS</small>{pair.question}</span></p></div></div>
              <div class="ps-chat-message ps-chat-message--answer"><div class="ps-chat-message-inner"><div class="ps-chat-reply"><span class="ps-chat-typing"><i /><i /><i /></span><p class="ps-brief-answer"><span class="ps-answer-person"><RolePortrait role="ceo" /></span><span class="ps-chat-bubble"><small>{v.intake.uploader}</small>{pair.answer}</span></p></div></div></div>
            </div>)}</div></div>
            <div class="ps-brief-ready"><Icon name="check" /><b>{v.intake.ready}</b><span>{v.audiences.join(' · ')}</span></div>
          </div>}
          {i === 2 && <div class="ps-paths-scene"><div class="ps-source-node"><Icon name="pdf" /><b>{v.policy}</b><span>v1</span></div><div class="ps-branches"><span /><span /><span /></div><div class="ps-role-paths">{v.audiences.map((role, n) => <div class="ps-role" data-department={roles[n]}><div class="ps-department-domain"><Icon name="lock" /><span>{domains[n]}</span></div><span class="ps-role-person"><RolePortrait role={roles[n] ?? "hr"} /></span><h4>{role}</h4><p>{v.roleTopics[n]}</p><span class="ps-cite"><Icon name="quote" /> {v.section}</span></div>)}</div></div>}
          {i === 3 && <div class="ps-learn-scene"><div class="ps-academy"><div class="ps-browser"><span class="ps-dots">● ● ●</span><span>{v.academy}</span><Icon name="lock" /></div><div class="ps-academy-body"><span class="ps-small ps-learner-identity"><span class="ps-learner-person"><RolePortrait role="sales" /></span>{v.audiences[2]} · v1</span><h4>{v.lesson}</h4><div class="ps-lesson-tiles">{v.formats.map((format, n) => <span><Icon name={['interactive', 'quiz', 'medal'][n] ?? 'book'} />{format}<Icon name="check" /></span>)}</div></div></div><div class="ps-certificate"><Icon name="medal" /><span>PDF</span><h4>{v.certificate}</h4><span class="ps-certificate-line" /><b>{v.policy}</b><small>v1</small><span class="ps-certified"><Icon name="check" />{v.completed}</span></div></div>}
          {i === 4 && <div class="ps-owner-scene"><div class="ps-owner-title"><span class="ps-owner-avatar"><RolePortrait role="hr" /></span><div><small>{v.owner}</small><h4>{v.progress}</h4></div><span class="ps-source-tag">v1</span></div><div class="ps-roster">{v.learners.map((learner, n) => <div><span><span class="ps-roster-person"><RolePortrait role={roles[n] ?? "hr"} /></span>{learner}</span><span class={n < 2 ? 'ps-complete' : 'ps-pending'}><Icon name={n < 2 ? 'check' : 'clock'} />{n < 2 ? v.completed : v.pending}</span><span class="ps-roster-pdf">{n < 2 ? 'PDF · v1' : '—'}</span></div>)}</div><span class="ps-roster-source"><Icon name="quote" /> {v.policy} · v1</span></div>}
          {i === 5 && <div class="ps-update-scene"><div class="ps-update-doc"><span class="ps-small"><Icon name="clock" />{v.later}</span><h4>{v.policy} <b>v2</b></h4><span class="ps-section">{v.section}</span><p class="ps-removed">− {v.before}</p><p class="ps-added">+ {v.after}</p></div><Icon name="arrow" class="ps-update-arrow" /><div class="ps-proposal"><span class="ps-small">ULAMS · {v.proposal}</span><div class="ps-impacted"><Icon name="book" /><span>{v.lesson}</span><Icon name="quote" /></div><div class="ps-impacted"><Icon name="quiz" /><span>{v.exam}</span><Icon name="quote" /></div><div class="ps-approval"><Icon name="shield" />{v.approval}</div></div></div>}
          {i === 6 && <div class="ps-renew-scene"><div class="ps-renew-left"><div class="ps-notification"><Icon name="mail" /><div><b>{v.policy} · v2</b><p>{v.notification}</p></div></div><span class="ps-expired"><Icon name="medal" /> PDF · v1 <b>{v.expired}</b></span><div class="ps-renew-paths"><span><Icon name="quiz" />{v.minor}</span><span><Icon name="book" />{v.major}</span></div></div><Icon name="arrow" class="ps-update-arrow" /><div class="ps-certificate ps-certificate--renewed"><Icon name="medal" /><span>PDF</span><h4>{v.renewed}</h4><span class="ps-certificate-line" /><b>{v.policy}</b><small>v2</small><span class="ps-certified"><Icon name="check" />{v.renewal}</span></div></div>}
        </div>
      </section>)}
    </div>
    <div class="ps-bottom">
      <div class="ps-navigation" role="tablist" aria-label={ariaLabel}>{v.chapters.map((label, i) => <button type="button" role="tab" id={`policy-tab-${i}`} aria-controls={`policy-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-step={i} style={`--ps-dwell:${i === 0 ? 10500 : i === 1 ? 15000 : 6000}ms`}><span class="ps-step-mark"><Icon name={icons[i] ?? "book"} /></span><i class="ps-dwell" aria-hidden="true"><b></b></i><span>{label}</span></button>)}</div>
      <div class="ps-controls"><button type="button" data-play aria-label={t.pause} title={t.pause} data-pause-label={t.pause} data-play-label={t.play} aria-pressed="false"><Icon name="pause" class="ps-pause-icon" /><Icon name="play" class="ps-play-icon" /></button><button type="button" data-replay aria-label={t.replay} title={t.replay}><Icon name="sync" /></button></div>
    </div>
  </ulams-policy-story>
  {note && <figcaption>{note}</figcaption>}
</figure>
<noscript><style is:inline>.ps-panel[hidden]{display:block!important}.ps-bottom{display:none!important}.ps-panel+.ps-panel{border-top:1px solid var(--ulams-color-border)}ulams-policy-story *{animation:none!important}.ps-chat-message{grid-template-rows:1fr!important}.ps-chat-typing{display:none!important}</style></noscript>
<script>
  class PolicyStory extends HTMLElement {
    private index = 0;
    private motion = matchMedia("(prefers-reduced-motion: reduce)");
    private paused = this.motion.matches;
    private visible = false;
    private timer?: ReturnType<typeof setTimeout>;
    private observer?: IntersectionObserver;
    private tabs: HTMLButtonElement[] = [];
    private panels: HTMLElement[] = [];
    connectedCallback() {
      this.tabs = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-step]")
      );
      this.panels = Array.from(this.querySelectorAll<HTMLElement>(".ps-panel"));
      this.tabs.forEach((tab, i) => {
        tab.addEventListener("click", (event) => {
          this.paused = this.motion.matches || event.detail === 0;
          this.toggleAttribute("data-settled", this.paused);
          this.select(i);
          this.updatePlayback();
        });
        tab.addEventListener("keydown", (e) => {
          const next =
            e.key === "ArrowRight"
              ? (i + 1) % this.tabs.length
              : e.key === "ArrowLeft"
              ? (i + this.tabs.length - 1) % this.tabs.length
              : e.key === "Home"
              ? 0
              : e.key === "End"
              ? this.tabs.length - 1
              : -1;
          if (next >= 0) {
            e.preventDefault();
            this.tabs[next]?.click();
            this.tabs[next]?.focus();
          }
        });
      });
      this.querySelector("[data-play]")?.addEventListener("click", () => {
        this.paused = !this.paused;
        if (!this.paused) this.removeAttribute("data-settled");
        this.updatePlayback();
      });
      this.querySelector("[data-replay]")?.addEventListener("click", () => {
        this.toggleAttribute("data-settled", this.motion.matches);
        this.select(0);
        this.paused = this.motion.matches;
        this.updatePlayback();
      });
      this.addEventListener("animationend", (event) => {
        if ((event as AnimationEvent).animationName !== "ps-chat-expand") return;
        const chat = (event.target as Element).closest<HTMLElement>(".ps-brief-chat");
        if (chat) chat.scrollTop = chat.scrollHeight;
      });
      this.observer = new IntersectionObserver(
        ([entry]) => {
          this.visible = Boolean(entry?.isIntersecting);
          this.updatePlayback();
        },
        { threshold: 0.2 }
      );
      this.observer.observe(this);
      document.addEventListener("visibilitychange", this.onVisibility);
      this.motion.addEventListener("change", this.onMotion);
      this.armDwell();
      this.updatePlayback();
    }
    disconnectedCallback() {
      clearTimeout(this.timer);
      this.observer?.disconnect();
      document.removeEventListener("visibilitychange", this.onVisibility);
      this.motion.removeEventListener("change", this.onMotion);
    }
    private onMotion = () => {
      if (this.motion.matches) this.paused = true;
      this.updatePlayback();
    };
    private onVisibility = () => this.updatePlayback();
    private select(i: number) {
      this.index = i;
      this.tabs.forEach((tab, n) => {
        tab.setAttribute("aria-selected", String(n === i));
        tab.tabIndex = n === i ? 0 : -1;
      });
      const scenes = this.panels[i]?.parentElement;
      const from = scenes?.getBoundingClientRect().height ?? 0;
      if (scenes) scenes.style.height = "";
      this.panels.forEach((panel) => { panel.hidden = true; });
      // Restart the selected scene's visual sequence, including when replaying scene zero.
      void this.offsetWidth;
      const panel = this.panels[i];
      if (panel) {
        panel.hidden = false;
        const chat = panel.querySelector<HTMLElement>(".ps-brief-chat");
        if (chat) chat.scrollTop = 0;
      }
      if (scenes) this.resize(scenes, from);
      this.armDwell();
    }
    /** Animate the scene box to the height of the new chapter so no chapter leaves empty space. */
    private resize(scenes: HTMLElement, from: number) {
      scenes.removeAttribute("data-resizing");
      const to = scenes.getBoundingClientRect().height;
      if (this.motion.matches || !from || Math.abs(to - from) < 1) return;
      scenes.style.height = `${from}px`;
      void scenes.offsetHeight;
      scenes.setAttribute("data-resizing", "");
      scenes.style.height = `${to}px`;
      const done = (event: TransitionEvent) => {
        if (event.target !== scenes || event.propertyName !== "height") return;
        scenes.removeEventListener("transitionend", done);
        if (scenes.style.height !== `${to}px`) return;
        scenes.style.height = "";
        scenes.removeAttribute("data-resizing");
      };
      scenes.addEventListener("transitionend", done);
    }
    /** Restart the bar under the active icon so it fills across that chapter's duration. */
    private armDwell() {
      this.tabs.forEach((tab) => tab.querySelector(".ps-dwell")?.classList.remove("is-running"));
      const dwell = this.tabs[this.index]?.querySelector<HTMLElement>(".ps-dwell");
      if (!dwell || this.motion.matches) return;
      void dwell.offsetWidth;
      dwell.classList.add("is-running");
    }
    private updatePlayback() {
      clearTimeout(this.timer);
      this.toggleAttribute("data-paused", this.paused);
      this.toggleAttribute("data-animation-paused", this.paused || !this.visible || document.hidden);
      const button = this.querySelector<HTMLButtonElement>("[data-play]");
      button?.setAttribute("aria-pressed", String(this.paused));
      const label =
        (this.paused ? button?.dataset.playLabel : button?.dataset.pauseLabel) ??
        "";
      button?.setAttribute("aria-label", label);
      button?.setAttribute("title", label);
      if (!this.paused && this.visible && !document.hidden)
        this.timer = setTimeout(() => {
          if (!this.tabs.some((tab) => tab === document.activeElement)) this.select((this.index + 1) % this.tabs.length);
          this.updatePlayback();
        }, Number(this.panels[this.index]?.dataset.duration ?? 6000));
    }
  }
  if (!customElements.get("ulams-policy-story"))
    customElements.define("ulams-policy-story", PolicyStory);
</script>
<style>
  .policy-story {
    width: 100%;
    margin: 0;
    color: var(--ulams-color-text);
    font-family: var(--ulams-font-family-body);
    text-align: left;
  }
  ulams-policy-story {
    display: block;
    overflow: hidden;
    background: transparent;
    border-block: 1px solid var(--ulams-color-border);
    border-radius: 0;
  }
  .ps-topline {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    color: var(--ulams-color-muted);
    font: 600 0.67rem var(--ulams-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--ulams-color-border);
  }
  .ps-version {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: var(--ulams-color-primary);
  }
  .ps-version :global(svg) {
    width: 14px;
  }
  .ps-scenes {
    display: grid;
  }
  .ps-scenes[data-resizing] {
    overflow: hidden;
    transition: height 0.35s ease;
  }
  .ps-panel {
    display: grid;
    grid-area: 1/1;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    gap: 30px;
    align-items: center;
    min-height: 520px;
    padding: 30px;
    animation: ps-enter 0.45s ease both;
  }
  .ps-panel[hidden] {
    display: none;
  }
  .ps-narration {
    min-width: 0;
  }
  .ps-chapter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    color: var(--ulams-color-muted);
    font: 500 0.68rem var(--ulams-font-mono);
  }
  .ps-narration h2 {
    margin: 18px 0 12px;
    color: var(--ulams-color-text);
    font-weight: 700;
    font-size: 1.55rem;
    font-family: var(--ulams-font-family-body);
    line-height: 1.2;
    letter-spacing: -0.045em;
  }
  .ps-narration > p {
    margin: 0;
    color: var(--ulams-color-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .ps-scene {
    display: grid;
    min-width: 0;
    min-height: 320px;
    padding: 18px;
    background: transparent;
    border-radius: 0;
    place-items: center;
  }
  .ps-explanation { display:grid; gap:9px; margin:17px 0 0; padding-left:18px; color:var(--ulams-color-text); font-size:.8rem; line-height:1.6; }
  .ps-explanation li { padding-left:3px; }
  .ps-explanation li::marker { color:var(--ulams-color-accent); }
  .ps-scene h4 {
    margin: 10px 0;
    color: var(--ulams-color-text);
    font: 700 1rem/1.3 var(--ulams-font-family-body);
    letter-spacing: -0.025em;
  }
  .ps-small,
  .ps-section {
    display: flex;
    gap: 5px;
    align-items: center;
    color: var(--ulams-color-muted);
    font: 500 0.64rem/1.5 var(--ulams-font-mono);
  }
  .ps-small :global(svg) {
    width: 14px;
  }
  .ps-document {
    width: 260px;
    max-width: 100%;
    padding: 24px;
    background: var(--ulams-color-card-bg);
    border: 1px solid var(--ulams-color-border);
    border-radius: 3px 3px 16px 3px;
    box-shadow: 8px 8px 0
        color-mix(in srgb, var(--ulams-color-primary) 5%, transparent),
      0 12px 35px -25px var(--ulams-color-primary);
    transform: rotate(-3deg);
  }
  .ps-source-scene {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .ps-file {
    display: flex;
    gap: 5px;
    align-items: center;
    color: var(--ulams-color-muted);
    font: 500 0.55rem var(--ulams-font-mono);
  }
  .ps-file :global(svg) {
    width: 16px;
  }
  .ps-file b {
    margin-left: auto;
  }
  .ps-document h4 {
    margin-top: 22px;
    font-size: 1.25rem;
  }
  .ps-doc-rule {
    display: block;
    height: 2px;
    margin: 12px 0;
    background: var(--ulams-color-primary);
  }
  .ps-quote {
    font-size: 0.77rem;
    line-height: 1.5;
  }
  .ps-paper-lines {
    display: grid;
    gap: 6px;
    margin: 20px 0;
  }
  .ps-paper-lines i {
    height: 4px;
    background: var(--ulams-color-border);
  }
  .ps-paper-lines i:last-child {
    width: 65%;
  }
  .ps-doc-footer {
    color: var(--ulams-color-muted);
    font: 500 0.55rem var(--ulams-font-mono);
  }
  .ps-source-link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    color: var(--ulams-color-muted);
    font-size: 0.67rem;
    text-align: center;
  }
  .ps-source-link :global(svg) {
    width: 25px;
    color: var(--ulams-color-primary);
  }
  .ps-paths-scene {
    width: 100%;
  }
  .ps-source-node {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
  }
  .ps-source-node :global(svg) {
    width: 20px;
  }
  .ps-source-node > span {
    padding: 3px 7px;
    font: 500 0.6rem var(--ulams-font-mono);
    border: 1px solid var(--ulams-color-border);
    border-radius: 4px;
  }
  .ps-branches {
    display: flex;
    justify-content: center;
    width: 68%;
    height: 30px;
    margin: 12px auto 0;
    border-top: 1px solid var(--ulams-color-primary);
  }
  .ps-branches span {
    width: 50%;
    border-left: 1px solid var(--ulams-color-primary);
  }
  .ps-branches span:last-child {
    width: 0;
  }
  .ps-role-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
  }
