  .ps-role[data-department="hr"] { border-radius:16px 16px 4px 4px; border-top:3px solid var(--ulams-color-accent); background:color-mix(in srgb,var(--ulams-color-accent) 7%,var(--ulams-color-card-bg)); }
  .ps-role[data-department="hr"] h4 { font-family:var(--ulams-font-family); font-size:1.1rem; }
  .ps-role[data-department="sales"] { border-radius:6px; border-top:3px solid var(--ulams-color-positive); background:color-mix(in srgb,var(--ulams-color-positive) 7%,var(--ulams-color-card-bg)); }
  .ps-upload-file { display:flex; align-items:center; gap:9px; padding:10px 8px; background:var(--ulams-color-bg); border:1px solid var(--ulams-color-border); border-radius:7px; }
