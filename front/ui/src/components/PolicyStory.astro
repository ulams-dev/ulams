  .ps-controls :global(.ps-play-icon),
  .ps-controls [aria-pressed="true"] :global(.ps-pause-icon) {
    display: none;
  }
  .ps-controls [aria-pressed="true"] :global(.ps-play-icon) {
    display: block;
  }
  .ps-navigation button:focus-visible,
  .ps-controls button:focus-visible,
  .ps-panel:focus-visible {
    outline: 3px solid var(--ulams-brand-blue);
    outline-offset: 3px;
