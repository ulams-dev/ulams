---
import { uiStrings, pageLocale } from "../lib/i18n.ts";
/**
 * "Your brand, your academy": the white-label story of the product landing, in four steps played by
 * the shared timeline player (elements/story.ts, no extra JS): bring a brand (tokens are extracted),
 * get a themed site on its own subdomain, bring content (one course per source), see per-course
 * learner analytics. Under the stage a short numbered list says the same in words, with the honest
 * status of each step. The stage is decorative (aria-hidden); `description` and the list carry the story.
 *
 * Scenes sit in one grid cell (the stage takes the height of the tallest, so nothing shifts), the rail
 * shows the current step. With `prefers-reduced-motion` or without JS the four scenes stack, each in
 * its final state. All names, colours and numbers in the stage are an example, never a customer.
 */
import Icon from "./Icon.astro";
import StoryStyles from "./StoryStyles.astro";

type Status = "available" | "coming";
interface Link {
  label: string;
  href: string;
}
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  valueLine?: string;
  description: string;
  exampleNote?: string;
  primaryCta?: Link;
  secondaryCta?: Link;
  steps: Array<{ title: string; text: string; points?: string[]; status?: Status; today?: string }>;
  brand: {
    sources: Array<{ kind: "figma" | "stitch" | "pdf" | "logo"; label: string; file: string; status?: Status }>;
    agentLabel: string;
    sourcesLabel: string;
    alternative: { label: string; text: string };
    commands: string[];
    tokensLabel: string;
    colors: Array<{ name: string; value: string }>;
    fonts: Array<{ role: string; name: string }>;
    logo: string;
    radius: number;
  };
  site: { host: string; pages: string[]; headline: string; action: string };
  content: {
    sources: Array<{ kind: "doc" | "pdf" | "git" | "url"; label: string; course: string; status?: Status }>;
    builderLabel: string;
    citedLabel: string;
    syncLabel: string;
    syncStatus?: Status;
  };
  dashboard: {
    kpis: Array<{ label: string; value: number }>;
    quiz: { label: string; bars: Array<{ label: string; value: number }> };
    atRisk: { label: string; learners: Array<{ name: string; reason: string }> };
    confusing: { label: string; sections: Array<{ title: string; level: number }> };
  };
}
const {
  id = "white-label",
  eyebrow,
  title,
  intro,
  valueLine,
  description,
  exampleNote,
  primaryCta,
  secondaryCta,
  steps,
  brand,
  site,
  content,
  dashboard,
} = Astro.props;

const t = uiStrings(pageLocale(Astro));
const hex = (v: string | undefined, fallback: string) => (v && /^#[0-9a-f]{6}$/i.test(v) ? v : fallback);
const [cPrimary, cSecondary, cAccent, cSurface, cText] = [
  hex(brand.colors[0]?.value, "#0E7C66"),
  hex(brand.colors[1]?.value, "#1B2A41"),
  hex(brand.colors[2]?.value, "#F5B841"),
  hex(brand.colors[3]?.value, "#F6F4EF"),
  hex(brand.colors[4]?.value, "#16202B"),
];
const radius = Math.max(0, Math.min(32, Math.round(brand.radius)));
const siteVars = `--wl-p:${cPrimary};--wl-s:${cSecondary};--wl-a:${cAccent};--wl-bg:${cSurface};--wl-t:${cText};--wl-r:${radius}px`;
const courses = content.sources.map((s) => s.course);
const pct = (n: number) => Math.max(4, Math.min(100, Math.round(n))) / 100;
const comingTag = (s?: Status) => s === "coming";

// schedule (ms): the four steps start at S, scenes and rail follow it
const S = [0, 4600, 9200, 13800];
const total = 17900;
const rel = (step: number, ms: number) => S[step]! + ms;
const kindIcon = { figma: "layers", stitch: "sparkle", pdf: "pdf", logo: "star", doc: "reading", git: "code", url: "embed" } as const;
const step = (i: number) => steps[i] ?? { title: "", text: "" };
---

<section class="u-section u-wl" id={id} aria-labelledby={title ? `${id}-title` : undefined}>
  <StoryStyles />
  <noscript>
    <style is:inline>
      .u-wl__scenes {
        display: grid !important;
        gap: 22px;
      }
      .u-wl__scene {
        grid-area: auto !important;
        opacity: 1 !important;
        visibility: visible !important;
      }
      .u-wl__rail {
        display: none !important;
      }
      .u-wl__sh {
        display: block !important;
      }
      .u-wl__bar i {
        transform: scaleX(var(--w)) !important;
      }
    </style>
  </noscript>
  <div class="u-container">
    <div class="u-section-head u-section-head--center" data-reveal>
      {eyebrow && <p class="u-eyebrow">{eyebrow}</p>}
      {title && <h2 class="u-h2" id={`${id}-title`}>{title}</h2>}
      {intro && <p class="u-lead">{intro}</p>}
    </div>

    <ulams-story class="u-stage u-wl__stage" data-total={total} data-hold="3800" loop>
      <p class="u-visually-hidden">{description}</p>
      <div aria-hidden="true">
        <ol class="u-wl__rail">
          {
            steps.map((s, i) => (
              <li data-at={S[i]} data-at2={S[i + 1]}>
                <b>{i + 1}</b>
                <span>{s.title}</span>
              </li>
            ))
          }
        </ol>
        <div class="u-wl__scenes">
          <!-- 1 · bring your brand -->
          <div class="u-wl__scene" data-at={S[0]} data-at2={S[1]}>
            <p class="u-wl__sh">{`1 · ${step(0).title}`}</p>
            <div class="u-win">
              <div class="u-win__bar">
                <span class="u-win__dots"><i></i><i></i><i></i></span><span>{brand.agentLabel}</span>
                {comingTag(step(0).status) && <em class="u-wl__tag">{t.coming}</em>}
              </div>
              <div class="u-wl__cols u-wl__cols--brand">
                <div class="u-wl__col">
                  <p class="u-wl__cap">{brand.sourcesLabel}</p>
                  <ul class="u-wl__files">
                    {
                      brand.sources.map((s, i) => (
                        <li data-at={rel(0, 300 + i * 300)}>
                          <Icon name={kindIcon[s.kind]} />
                          <span>
                            <b>{s.label}</b>
                            <small>{s.file}</small>
                          </span>
                          {comingTag(s.status) && <em class="u-wl__tag">{t.coming}</em>}
                        </li>
                      ))
                    }
                  </ul>
                  <p class="u-wl__alt" data-at={rel(0, 3500)}>
                    <Icon name="code" />
                    <span>
                      <b>{brand.alternative.label}</b>
                      <small>{brand.alternative.text}</small>
                    </span>
                  </p>
                </div>
                <div class="u-wl__col">
                  <p class="u-wl__cap" data-at={rel(0, 1500)}><Icon name="terminal" />{brand.tokensLabel}</p>
                  <ul class="u-wl__sw">
                    {
                      brand.colors.map((c, i) => (
                        <li data-at={rel(0, 1900 + i * 180)}>
                          <i style={`background:${hex(c.value, "#888888")}`}></i>
                          <span>{c.name}</span>
                          <code>{c.value}</code>
                        </li>
                      ))
                    }
                  </ul>
                  <div class="u-wl__meta">
                    {
                      brand.fonts.map((f, i) => (
                        <p class={`u-wl__font u-wl__font--${i}`} data-at={rel(0, 2900 + i * 200)}>
                          <b>Aa</b>
                          <span>{f.role}</span>
                          <code>{f.name}</code>
                        </p>
                      ))
                    }
                    <p class="u-wl__logo" data-at={rel(0, 3300)}>
                      <b style={`background:${cPrimary}`}>{brand.logo}</b>
                      <span>{t.logo}</span>
                    </p>
                    <p class="u-wl__rad" data-at={rel(0, 3500)}>
                      <i style={`border-top-left-radius:${radius}px`}></i>
                      <span>{t.radius}</span>
                      <code>{radius} px</code>
                    </p>
                  </div>
                  <div class="u-wl__cmds">
                    {
                      brand.commands.map((c, i) => (
                        <code data-at={rel(0, 3700 + i * 450)} data-type="420">{c}</code>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 2 · get your academy -->
          <div class="u-wl__scene" data-at={S[1]} data-at2={S[2]}>
            <p class="u-wl__sh">{`2 · ${step(1).title}`}</p>
            <div class="u-win">
              <div class="u-win__bar">
                <span class="u-win__dots"><i></i><i></i><i></i></span>
                <span class="u-wl__url"><Icon name="lock" /><span data-at={rel(1, 200)} data-type="1000">{site.host}</span></span>
              </div>
              <div class="u-wl__pages" style={siteVars}>
                {
                  [0, 1, 2].map((p) => (
                    <div class="u-wl__page" data-at={rel(1, 1400 + p * 650)}>
                      <p class="u-wl__pcap">{site.pages[p]}</p>
                      <div class={`u-site u-site--${["landing", "catalogue", "admin"][p]}`}>
                        <div class="u-site__top">
                          <b>{brand.logo}</b>
                          <i></i>
                          <i></i>
                        </div>
                        {p === 0 && (
                          <div class="u-site__hero">
                            <strong>{site.headline}</strong>
                            <i></i>
                            <span>{site.action}</span>
                          </div>
                        )}
                        {p === 1 && (
                          <div class="u-site__grid">
                            {courses.slice(0, 4).map((c) => (
                              <div>
                                <i></i>
                                <span>{c}</span>
                              </div>
                            ))}
                          </div>
                        )}
                        {p === 2 && (
                          <div class="u-site__rows">
                            {courses.slice(0, 4).map((c) => (
                              <div>
                                <span>{c}</span>
                                <i></i>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- 3 · bring your content -->
          <div class="u-wl__scene" data-at={S[2]} data-at2={S[3]}>
            <p class="u-wl__sh">{`3 · ${step(2).title}`}</p>
            <div class="u-win">
              <div class="u-win__bar">
                <span class="u-win__dots"><i></i><i></i><i></i></span><span>{step(2).title}</span>
              </div>
              <div class="u-wl__cols u-wl__cols--content">
                <div class="u-wl__col">
                  <p class="u-wl__cap">{t.sources}</p>
                  <ul class="u-wl__files">
                    {
                      content.sources.map((s, i) => (
                        <li data-at={rel(2, 250 + i * 330)}>
                          <Icon name={kindIcon[s.kind]} />
                          <span>
                            <b>{s.label}</b>
                          </span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <div class="u-wl__col">
                  <p class="u-wl__cap" data-at={rel(2, 1500)}><Icon name="sparkle" />{content.builderLabel}</p>
                  <ul class="u-wl__courses">
                    {
                      content.sources.map((s, i) => (
                        <li data-at={rel(2, 1700 + i * 380)}>
                          <b>{s.course}</b>
                          <span class="u-chip2">{content.citedLabel}</span>
                        </li>
                      ))
                    }
                  </ul>
                  <p class="u-wl__sync" data-at={rel(2, 3500)}>
                    <Icon name="sync" />
                    {content.syncLabel}
                    {comingTag(content.syncStatus) && <em class="u-wl__tag">{t.coming}</em>}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- 4 · see everything -->
          <div class="u-wl__scene" data-at={S[3]} data-at2={undefined}>
            <p class="u-wl__sh">{`4 · ${step(3).title}`}</p>
            <div class="u-win">
              <div class="u-win__bar">
                <span class="u-win__dots"><i></i><i></i><i></i></span><span>{step(3).title}</span>
                {comingTag(step(3).status) && <em class="u-wl__tag">{t.coming}</em>}
                {exampleNote && <em class="u-wl__ex">{exampleNote}</em>}
              </div>
              <div class="u-wl__dash">
                <div class="u-wl__tabs">
                  {courses.map((c, i) => <span class={i === 0 ? "is-on" : ""}>{c}</span>)}
                </div>
                <div class="u-wl__kpis">
                  {
                    dashboard.kpis.slice(0, 3).map((k, i) => (
                      <div data-at={rel(3, 200 + i * 260)}>
                        <span>{k.label}</span>
                        <p class="u-wl__bar" style={`--w:${pct(k.value)}`}><i></i></p>
                      </div>
                    ))
                  }
                </div>
                <div class="u-wl__panels">
                  <div class="u-wl__panel">
                    <p class="u-wl__cap" data-at={rel(3, 1100)}>{dashboard.quiz.label}</p>
                    {
                      dashboard.quiz.bars.slice(0, 4).map((b, i) => (
                        <div class="u-wl__row" data-at={rel(3, 1250 + i * 200)}>
                          <span>{b.label}</span>
                          <p class="u-wl__bar" style={`--w:${pct(b.value)}`}><i></i></p>
                        </div>
                      ))
                    }
                  </div>
                  <div class="u-wl__panel">
                    <p class="u-wl__cap" data-at={rel(3, 2100)}>{dashboard.atRisk.label}</p>
                    {
                      dashboard.atRisk.learners.slice(0, 3).map((l, i) => (
                        <div class="u-wl__risk" data-at={rel(3, 2250 + i * 330)}>
                          <b>{l.name}</b>
                          <span>{l.reason}</span>
                        </div>
                      ))
                    }
                  </div>
                  <div class="u-wl__panel">
                    <p class="u-wl__cap" data-at={rel(3, 3100)}>{dashboard.confusing.label}</p>
                    {
                      dashboard.confusing.sections.slice(0, 3).map((c, i) => (
                        <div class="u-wl__row" data-at={rel(3, 3250 + i * 280)}>
                          <span>{c.title}</span>
                          <p class="u-wl__bar u-wl__bar--heat" style={`--w:${pct(c.level * 20)}`}><i></i></p>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="u-stage__controls">
        <button type="button" data-pause aria-pressed="false" data-label-pause={t.pause} data-label-play={t.play}>{t.pause}</button>
        <button type="button" data-replay>{t.replay}</button>
      </div>
    </ulams-story>

    <ol class="u-wl__list">
      {
        steps.map((s, i) => (
          <li class="u-wl__item">
            <p class="u-wl__n" aria-hidden="true">{i + 1}</p>
            <h3 class="u-h3">{s.title}</h3>
            {s.status === "coming" && <p class="u-status u-status--coming">{t.coming}</p>}
            <p>{s.text}</p>
            {s.points && s.points.length > 0 && (
              <ul>
                {s.points.map((p) => (
                  <li>
                    <Icon name="check" />
                    {p}
                  </li>
                ))}
              </ul>
            )}
            {s.today && <p class="u-wl__today">{s.today}</p>}
          </li>
        ))
      }
    </ol>
    {valueLine && <p class="u-wl__value">{valueLine}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="u-actions u-wl__cta">
          {primaryCta && (
            <a class="u-btn" href={primaryCta.href}>
              {primaryCta.label}
              <Icon name="arrow" />
            </a>
          )}
          {secondaryCta && (
            <a class="u-btn u-btn--ghost" href={secondaryCta.href}>
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style is:global>
  .u-wl__stage {
    font-family: var(--ulams-font-family-body, system-ui, sans-serif);
    font-size: 0.875rem;
  }
  .u-wl__stage .u-win {
    font-family: inherit;
  }
  .u-wl__stage .u-win__bar {
    font-family: var(--ulams-font-mono);
    min-height: 38px;
  }
  .u-wl__tag,
  .u-wl__ex {
    margin-left: auto;
    padding: 0 8px;
    border-radius: 999px;
    font-style: normal;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--st-dim);
    border: 1px dashed currentColor;
    white-space: nowrap;
  }
  .u-wl__ex {
    border-style: solid;
    text-transform: none;
  }
  .u-wl__tag + .u-wl__ex {
    margin-left: 8px;
  }
  /* rail */
  .u-wl__rail {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .u-wl__rail li[data-at] {
    opacity: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid var(--st-line);
    color: var(--st-dim);
    transition:
      color 0.4s,
      border-color 0.4s,
      background-color 0.4s;
  }
  .u-wl__rail b {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-family: var(--ulams-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .u-wl__rail span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }
  .u-wl__rail li.on:not(.on2) {
    color: var(--st-text);
    border-color: color-mix(in srgb, var(--ulams-brand-orange) 70%, transparent);
    background: color-mix(in srgb, #fff 7%, transparent);
  }
  .u-wl__rail li.on:not(.on2) b {
    background: var(--ulams-brand-orange);
    border-color: var(--ulams-brand-orange);
    color: var(--ulams-brand-indigo);
  }
  .u-wl__rail li.on2 {
    color: var(--st-ok);
  }
  /* scenes: one grid cell, the tallest sets the height */
  .u-wl__scenes {
    display: grid;
  }
  .u-wl__scene {
    grid-area: 1 / 1;
    min-width: 0;
  }
  ulams-story .u-wl__scene[data-at] {
    visibility: hidden;
    transition:
      opacity 0.45s var(--ulams-ease),
      visibility 0s 0.45s;
  }
  ulams-story .u-wl__scene[data-at].on {
    visibility: visible;
    transition-delay: 0s;
  }
  ulams-story .u-wl__scene[data-at].on.on2 {
    opacity: 0;
    visibility: hidden;
  }
  .u-wl__sh {
    display: none;
    margin: 0 0 8px;
    font-weight: 700;
    color: var(--st-text);
  }
  .u-wl__cols {
    display: grid;
    min-height: 330px;
  }
  .u-wl__cols--brand,
  .u-wl__cols--content {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
  .u-wl__col {
    padding: 14px 16px;
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .u-wl__col + .u-wl__col {
    border-left: 1px solid var(--st-line);
  }
  .u-wl__cap {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ulams-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--st-dim);
  }
  .u-wl__alt {
    margin: 4px 0 0;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--ulams-brand-sky) 50%, transparent);
    background: color-mix(in srgb, var(--ulams-brand-sky) 8%, transparent);
    transform: translateY(8px);
  }
  .u-wl__alt.on {
    transform: none;
  }
  .u-wl__alt svg {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--ulams-brand-sky);
  }
  .u-wl__alt span {
    display: grid;
    min-width: 0;
  }
  .u-wl__alt b {
    color: var(--st-text);
    font-weight: 600;
  }
  .u-wl__alt small {
    color: var(--st-dim);
    font-size: 0.75rem;
  }
  .u-wl__cmds {
    display: grid;
    gap: 4px;
    margin-top: 4px;
    padding: 8px 10px;
    border-radius: 10px;
    background: color-mix(in srgb, #000 28%, transparent);
    font-family: var(--ulams-font-mono);
    font-size: 0.75rem;
  }
  .u-wl__cmds code {
    color: var(--st-text);
    overflow-wrap: anywhere;
    min-height: 1.6em;
  }
  .u-wl__cmds code::before {
    content: "$ ";
    color: var(--ulams-brand-orange);
  }
  .u-wl__cap svg {
    width: 14px;
    height: 14px;
    color: var(--ulams-brand-orange);
  }
  .u-wl__files,
  .u-wl__sw,
  .u-wl__courses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .u-wl__files li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px dashed color-mix(in srgb, var(--ulams-brand-orange) 65%, transparent);
    background: color-mix(in srgb, var(--ulams-brand-orange) 7%, transparent);
    transform: translateY(-14px);
    min-width: 0;
  }
  .u-wl__files li.on,
  .u-wl__sw li.on,
  .u-wl__courses li.on {
    transform: none;
  }
  .u-wl__files svg {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--ulams-brand-orange);
  }
  .u-wl__files span {
    display: grid;
    min-width: 0;
  }
  .u-wl__files b {
    font-weight: 600;
    color: var(--st-text);
    overflow-wrap: anywhere;
  }
  .u-wl__files small {
    color: var(--st-dim);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .u-wl__sw li {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 10px;
    transform: translateX(-10px);
  }
  .u-wl__sw i {
    width: 22px;
    height: 22px;
    border-radius: 6px;
