---
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  items: Array<{ name: string; text?: string; icon?: string }>;
  id?: string;
}
const { eyebrow, title, intro, items, id = "badges" } = Astro.props;
const icons = ["moon", "planet", "star", "telescope", "medal", "rocket"];
---

<section class="u-section u-badges" id={id} aria-labelledby={title ? `${id}-title` : undefined}>
  <div class="u-container">
    <div class="u-section-head u-section-head--center" data-reveal>
      {eyebrow && <p class="u-eyebrow">{eyebrow}</p>}
      {title && <h2 class="u-h2" id={`${id}-title`}>{title}</h2>}
      {intro && <p class="u-lead">{intro}</p>}
    </div>
    <ul class="u-badges__list" role="list">
      {
        items.map((badge, i) => (
          <li class="u-badge u-card u-card--hover" data-reveal style={`--reveal-i:${i};--hue:${i * 70}deg`}>
            <span class="u-badge__medal">
              <Icon name={badge.icon ?? icons[i % icons.length]!} />
            </span>
            <p class="u-badge__tier">Badge {i + 1}</p>
            <h3>{badge.name}</h3>
            {badge.text && <p class="u-badge__text">{badge.text}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .u-badges__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 18px;
  }
  .u-badge {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 8px;
    padding: 28px 20px;
  }
  .u-badge__medal {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    margin-bottom: 6px;
    border-radius: 50%;
    background: conic-gradient(from var(--hue), #ffd23f, #ff6b6b, #9b8cff, #3ddc97, #ffd23f);
    color: #13153a;
    box-shadow: inset 0 0 0 8px rgb(19 21 58 / 0.85), 0 10px 30px -10px rgb(255 210 63 / 0.5);
    transition: transform 0.8s var(--ulams-ease-bounce);
  }
  .u-badge__medal :global(.u-icon) {
    width: 34px;
    height: 34px;
    color: #fff;
  }
  .u-badge:hover .u-badge__medal {
    transform: rotate(360deg) scale(1.06);
  }
  .u-badge__tier {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ulams-color-primary);
  }
  .u-badge h3 {
    font-size: 1.3rem;
  }
  .u-badge__text {
    font-size: 0.9rem;
    color: var(--ulams-color-muted);
  }
</style>
