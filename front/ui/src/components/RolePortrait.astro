---
/** Editorial illustrations of example people; these are roles, not customer portraits. */
interface Props { role: 'ceo' | 'management' | 'hr' | 'sales'; label?: string; }
const { role, label } = Astro.props;
const palette = {
  ceo: { skin: '#d4a17d', hair: '#62666e' },
  management: { skin: '#97664c', hair: '#202b37' },
  hr: { skin: '#c68c6c', hair: '#3b2827' },
  sales: { skin: '#edbc98', hair: '#784137' },
}[role];
---
<svg viewBox="0 0 80 96" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" class={`role-portrait role-portrait--${role}`} style={`--ulams-person-skin:${palette.skin};--ulams-person-hair:${palette.hair}`}>
  <rect x="1" y="1" width="78" height="94" rx="18" fill="var(--ulams-color-surface, var(--ulams-color-bg))" />
  {(role === 'hr' || role === 'sales') && <path d="M17 38Q15 11 40 10Q66 12 63 42L67 71H13Z" fill="var(--ulams-person-hair)" />}
  {role === 'sales' && <circle cx="57" cy="16" r="11" fill="var(--ulams-person-hair)" />}
  <path d="M7 95V83Q8 68 29 65H51Q72 68 73 83V95Z" fill={role === 'hr' ? 'var(--ulams-color-accent)' : 'var(--ulams-color-primary)'} />
  <path d="M31 56H49V69L40 76L31 69Z" fill="var(--ulams-person-skin)" />
  <path d="M30 67L40 76L30 83L23 70ZM50 67L40 76L50 83L57 70Z" fill="var(--ulams-color-card-bg)" />
  <ellipse cx="40" cy="38" rx="19" ry="25" fill="var(--ulams-person-skin)" />
  {role === 'ceo' && <path d="M20 34Q16 14 35 10Q58 9 61 31L55 27Q45 16 27 27L25 37Z" fill="var(--ulams-person-hair)" />}
  {role === 'management' && <path d="M20 33L19 20Q23 7 39 10Q58 7 61 25L57 35L52 25Q33 30 27 22L25 36Z" fill="var(--ulams-person-hair)" />}
  {role === 'hr' && <path d="M19 35Q17 17 33 13Q54 10 61 32L52 27L47 19Q35 33 23 31Z" fill="var(--ulams-person-hair)" />}
  {role === 'sales' && <path d="M20 35Q17 17 36 12Q58 11 62 29L57 35L52 28Q40 29 32 18L25 36Z" fill="var(--ulams-person-hair)" />}
  <path d="M28 37Q32 35 35 37M46 37Q49 35 52 37" fill="none" stroke="var(--ulams-person-hair)" stroke-width="2" stroke-linecap="round" />
  <circle cx="32" cy="41" r="1.5" fill="var(--ulams-person-hair)" /><circle cx="49" cy="41" r="1.5" fill="var(--ulams-person-hair)" />
  <path d="M40 42L38 48H42M34 53Q40 58 47 52" stroke="var(--ulams-person-hair)" fill="none" stroke-width="1.5" stroke-linecap="round" />
  {(role === 'ceo' || role === 'management') && <g fill="none" stroke="var(--ulams-person-hair)" stroke-width="1.4"><rect x="24" y="36" width="14" height="11" rx="4" /><rect x="43" y="36" width="14" height="11" rx="4" /><path d="M38 39H43M21 38H24M57 38H59" /></g>}
  {role === 'ceo' && <path d="M40 76L36 82L39 95H42L45 82Z" fill="var(--ulams-color-accent)" />}
  {(role === 'hr' || role === 'sales') && <g fill="var(--ulams-color-accent)"><circle cx="22" cy="47" r="2" /><circle cx="59" cy="47" r="2" /></g>}
</svg>
<style>.role-portrait{display:block;width:100%;height:auto;}</style>
