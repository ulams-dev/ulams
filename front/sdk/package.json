{
  "name": "@ulams/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Framework-free TypeScript client for the ulams API. Runs on Node and in the browser (fetch only).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./h5p": "./src/h5p.ts",
    "./frames": "./src/frames.ts",
    "./tenant": "./src/tenant.ts",
    "./ag-ui": "./src/ag-ui.ts",
    "./course-builder": "./src/course-builder.ts",
    "./living-course": "./src/living-course.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../api/storage/api-docs/api-docs.json -o src/generated/openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2"
  },
  "peerDependencies": {
    "zod": "^3.25.18 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.4"
  }
}
